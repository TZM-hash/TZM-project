@page "{id:guid}"
@model EngineeringManager.Web.Pages.Companies.DetailsModel
@using EngineeringManager.Domain.Finance
@using EngineeringManager.Domain.Projects
@using EngineeringManager.Web.Presentation
@{
    ViewData["Title"] = Model.Company.Name;
    var uncollected = Model.Dashboard.ReceivableAmount - Model.Dashboard.CollectedAmount;
    var unpaid = Model.Dashboard.PayableAmount - Model.Dashboard.PaidAmount;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var collectionRate = Model.Dashboard.ReceivableAmount <= 0m
        ? 0d
        : (double)Math.Clamp(Model.Dashboard.CollectedAmount / Model.Dashboard.ReceivableAmount * 100m, 0m, 100m);
    var paymentRate = Model.Dashboard.PayableAmount <= 0m
        ? 0d
        : (double)Math.Clamp(Model.Dashboard.PaidAmount / Model.Dashboard.PayableAmount * 100m, 0m, 100m);
    var invoiceRate = Model.Dashboard.OutputInvoiceAmount <= 0m
        ? 0d
        : (double)Math.Clamp(Model.Dashboard.InputInvoiceAmount / Model.Dashboard.OutputInvoiceAmount * 100m, 0m, 100m);
    var costTotal = Model.Dashboard.PayrollCost + Model.Dashboard.EquipmentCost;
    var payrollShare = costTotal <= 0m
        ? 0d
        : (double)Math.Clamp(Model.Dashboard.PayrollCost / costTotal * 100m, 0m, 100m);
}

@section Scripts {
    <script type="module">
        import { initAttachmentPickers } from "/js/components/attachment-picker.js";
        import { initAttachmentPreview } from "/js/components/attachment-preview.js";

        initAttachmentPickers();
        initAttachmentPreview();

        const bindCreateDialog = (openSelector, dialogSelector) => {
            const dialog = document.querySelector(dialogSelector);
            if (!dialog) return;
            document.querySelector(openSelector)?.addEventListener("click", () => dialog.showModal());
            dialog.querySelectorAll("[data-company-create-dialog-close]").forEach((button) => {
                button.addEventListener("click", () => {
                    dialog.querySelector("form")?.reset();
                    dialog.close();
                });
            });
            if (dialog.dataset.dialogOpen === "true") dialog.showModal();
        };

        bindCreateDialog("[data-company-certificate-create-open]", "[data-company-certificate-create-dialog]");
        bindCreateDialog("[data-company-account-create-open]", "[data-company-account-create-dialog]");

        const detailedEditDialog = document.querySelector("[data-company-detailed-edit-dialog]");
        document.querySelector("[data-company-detailed-edit-open]")?.addEventListener("click", () => detailedEditDialog?.showModal());
        detailedEditDialog?.querySelectorAll("[data-company-detailed-edit-close]").forEach((button) => {
            button.addEventListener("click", () => detailedEditDialog.close());
        });
        if (detailedEditDialog?.dataset.dialogOpen === "true") detailedEditDialog.showModal();
    </script>
}

<div class="company-workspace company-workspace--details" data-company-detail-workspace>
<section class="page-heading compact-page-heading company-workspace-heading company-detail-heading">
    <div>
        <p class="eyebrow company-detail-kicker">@Model.Company.Code · @(Model.Company.CompanyCategoryName ?? "未分类")</p>
        <div class="company-detail-title-row">
            <h1>@Model.Company.Name</h1>
            <span class="pill @(Model.Company.IsActive ? "pill--success" : "pill--warning")">@(Model.Company.IsActive ? "启用" : "停用")</span>
        </div>
        <p class="page-lead">@(string.IsNullOrWhiteSpace(Model.Company.ShortName) ? "未设置公司简称" : Model.Company.ShortName) · 法人/经营者：@(Model.Company.LegalRepresentative ?? "未填写")</p>
    </div>
    <div class="button-row company-workspace-actions">
        <partial name="_CompanyScopeSwitcher" model="(Model.CompanyOptions, (Guid?)Model.Company.Id, Model.ActiveTab)" />
        <a class="button button--secondary button--action" asp-page="/Organization/Departments" asp-route-legalEntityId="@Model.Company.Id" asp-route-returnPage="/Companies/Details">部门设置</a>
        @if (Model.CanManage)
        {
            <a class="button button--secondary button--action" asp-page="Edit" asp-route-copyFrom="@Model.Company.Id">复制公司</a>
            <a class="button button--primary button--action" asp-page="Edit">新增公司</a>
        }
        <a class="button button--secondary button--action" asp-page="Index">返回全部公司</a>
    </div>
</section>

<section class="overview-strip company-stat-strip" aria-label="公司经营速览">
    <article class="is-accent" data-company-employee-count="@Model.EmployeeCount"><span>员工数量</span><strong>@Model.EmployeeCount</strong><small>当前在职员工</small></article>
    <article class="is-accent"><span>应收 / 已收</span><strong>@Model.Dashboard.ReceivableAmount.ToString("N2") / @Model.Dashboard.CollectedAmount.ToString("N2")</strong><small>回款进度 @collectionRate.ToString("0.#")%</small></article>
    <article class="is-success"><span>应付 / 已付</span><strong>@Model.Dashboard.PayableAmount.ToString("N2") / @Model.Dashboard.PaidAmount.ToString("N2")</strong><small>付款进度 @paymentRate.ToString("0.#")%</small></article>
    <article class="@(uncollected > 0m ? "is-warning" : "is-success")"><span>未收款</span><strong class="@(uncollected > 0m ? "company-amount--warning" : null)">@uncollected.ToString("N2")</strong><small>待跟进应收余额</small></article>
    <article class="@(unpaid > 0m ? "is-danger" : "is-success")"><span>未付款</span><strong class="@(unpaid > 0m ? "company-amount--danger" : null)">@unpaid.ToString("N2")</strong><small>待安排应付余额</small></article>
</section>

@if (Model.OrganizationSummary is not null)
{
    <partial name="_OrganizationSummary" model="new OrganizationSummaryViewModel(Model.OrganizationSummary)" />
}

<nav class="company-tabs" data-company-tabs aria-label="公司工作台标签">
    <a class="@(Model.ActiveTab == "overview" ? "is-active" : null)" asp-page="Details" asp-route-id="@Model.Company.Id" asp-route-tab="overview">经营概览</a>
    <a class="@(Model.ActiveTab == "profile" ? "is-active" : null)" asp-page="Details" asp-route-id="@Model.Company.Id" asp-route-tab="profile">基本信息</a>
    <a class="@(Model.ActiveTab == "certificates" ? "is-active" : null)" asp-page="Details" asp-route-id="@Model.Company.Id" asp-route-tab="certificates">证书信息</a>
    <a class="@(Model.ActiveTab == "accounts" ? "is-active" : null)" asp-page="Details" asp-route-id="@Model.Company.Id" asp-route-tab="accounts">账户信息</a>
    <a class="@(Model.ActiveTab == "projects" ? "is-active" : null)" asp-page="Details" asp-route-id="@Model.Company.Id" asp-route-tab="projects">项目与合同</a>
    <a class="@(Model.ActiveTab == "finance" ? "is-active" : null)" asp-page="Details" asp-route-id="@Model.Company.Id" asp-route-tab="finance">收付款与发票</a>
</nav>

@if (Model.ActiveTab == "overview")
{
    <section class="dashboard-grid company-dashboard-grid company-overview-grid">
        <article class="panel company-panel">
            <div class="panel-heading"><div><p class="eyebrow">金额对比</p><h2>收款、付款与开票</h2></div></div>
            <div class="comparison-chart company-comparison-chart">
                <div class="comparison-row"><div class="chart-label"><strong>应收 / 已收</strong><span>@Model.Dashboard.ReceivableAmount.ToString("N2") / @Model.Dashboard.CollectedAmount.ToString("N2")</span></div><div class="progress-track"><span class="progress-fill" style="width:@collectionRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div></div>
                <div class="comparison-row"><div class="chart-label"><strong>应付 / 已付</strong><span>@Model.Dashboard.PayableAmount.ToString("N2") / @Model.Dashboard.PaidAmount.ToString("N2")</span></div><div class="progress-track"><span class="progress-fill progress-fill--stage" style="width:@paymentRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div></div>
                <div class="comparison-row"><div class="chart-label"><strong>销项 / 进项发票</strong><span>@Model.Dashboard.OutputInvoiceAmount.ToString("N2") / @Model.Dashboard.InputInvoiceAmount.ToString("N2")</span></div><div class="progress-track"><span class="progress-fill company-progress-fill--violet" style="width:@invoiceRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div></div>
                <div class="comparison-row"><div class="chart-label"><strong>工资 / 设备成本</strong><span>@Model.Dashboard.PayrollCost.ToString("N2") / @Model.Dashboard.EquipmentCost.ToString("N2")</span></div><div class="progress-track"><span class="progress-fill company-progress-fill--amber" style="width:@payrollShare.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div></div>
            </div>
        </article>
        <article class="panel company-panel company-summary-panel">
            <div class="panel-heading"><div><p class="eyebrow">结构摘要</p><h2>关联规模</h2></div></div>
            @if (Model.WorkspaceSummary is null)
            {
                <p class="panel-copy">暂无结构摘要。</p>
            }
            else
            {
                <dl class="detail-grid project-summary-grid company-summary-tiles">
                    <div><dt>关联项目</dt><dd>@Model.WorkspaceSummary.ProjectCount</dd></div>
                    <div><dt>合同份数</dt><dd>@Model.WorkspaceSummary.ContractCount</dd></div>
                    <div><dt>启用账户 / 总数</dt><dd>@Model.WorkspaceSummary.ActiveAccountCount / @Model.WorkspaceSummary.TotalAccountCount</dd></div>
                    <div><dt>有效证书 / 总数</dt><dd>@Model.WorkspaceSummary.ValidCertificateCount / @Model.WorkspaceSummary.TotalCertificateCount</dd></div>
                    <div><dt>过期证书</dt><dd><span class="@(Model.WorkspaceSummary.ExpiredCertificateCount > 0 ? "text-danger" : null)">@Model.WorkspaceSummary.ExpiredCertificateCount</span></dd></div>
                </dl>
            }
        </article>
    </section>
    <section class="panel company-panel company-activity-panel">
        <div class="panel-heading"><div><p class="eyebrow">动态</p><h2>近期动态</h2></div></div>
        @if (Model.RecentActivity.Count == 0)
        {
            <p class="panel-copy">暂无近期项目、收付款或发票动态。</p>
        }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr><th>类型</th><th>摘要</th><th>金额</th><th>日期</th></tr></thead><tbody>
            @foreach (var item in Model.RecentActivity)
            {
                var kindLabel = item.Kind switch { "project" => "项目", "contract" => "合同", "collection" => "收款", "payment" => "付款", "invoice" => "发票", _ => item.Kind };
                <tr>
                    <td><span class="company-activity-pill company-activity-pill--@item.Kind">@kindLabel</span></td>
                    <td>
                        @if (item.ProjectId.HasValue)
                        {
                            <a asp-page="/Projects/Details" asp-route-id="@item.ProjectId">@item.Title</a>
                        }
                        else { @item.Title }
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle)) { <span class="panel-copy"> · @item.Subtitle</span> }
                    </td>
                    <td>@(item.Amount?.ToString("N2") ?? "—")</td>
                    <td>@(item.Date?.ToString("yyyy-MM-dd") ?? "—")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}
else if (Model.ActiveTab == "profile")
{
    <section class="content-grid company-detail-full-grid">
        <article class="panel compact-detail-panel inline-edit-shell" data-inline-edit="company-details" data-inline-cell-edit data-inline-edit-active="@(Model.QuickEditOpen ? "true" : "false")">
            <form method="post" asp-page-handler="QuickEdit" asp-route-id="@Model.Company.Id" asp-route-tab="profile">
                <div class="panel-heading"><h2>基本信息</h2>@if (Model.CanManage) { <div class="button-row"><button class="button button--primary button--action" type="button" data-inline-edit-open>快捷编辑公司</button><button class="button button--secondary button--action" type="button" data-company-detailed-edit-open>进入详细编辑</button><button class="button button--secondary button--action" type="button" data-inline-edit-cancel data-inline-edit-actions hidden>取消</button><button class="button button--primary button--action" type="submit" data-inline-edit-actions hidden>保存</button></div> }</div>
                <div asp-validation-summary="All" class="panel-copy"></div>
                <dl class="detail-grid project-summary-grid">
                    <div><dt>公司编码</dt><dd><span data-inline-edit-value>@Model.Company.Code</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.Code" data-inline-edit-control hidden required /> }</dd></div>
                    <div><dt>公司名称</dt><dd><span data-inline-edit-value>@Model.Company.Name</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.Name" data-inline-edit-control hidden required /> }</dd></div>
                    <div><dt>简称</dt><dd><span data-inline-edit-value>@Model.Company.ShortName</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.ShortName" data-inline-edit-control hidden required /> }</dd></div>
                    <div><dt>组合分类</dt><dd><span data-inline-edit-value>@(Model.Company.CompanyCategoryName ?? "未分类")</span>@if (Model.CanManage) { <select class="inline-cell-control" asp-for="QuickEdit.CompanyCategoryId" data-inline-edit-control hidden><option value="">未分类</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select> }</dd></div>
                    <div><dt>状态</dt><dd><span data-inline-edit-value>@(Model.Company.IsActive ? "启用" : "停用")</span>@if (Model.CanManage) { <select class="inline-cell-control" asp-for="QuickEdit.IsActive" data-inline-edit-control hidden><option value="true">启用</option><option value="false">停用</option></select> }</dd></div>
                    <div><dt>法人/经营者</dt><dd><span data-inline-edit-value>@(Model.Company.LegalRepresentative ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.LegalRepresentative" data-inline-edit-control hidden /> }</dd></div>
                    <div><dt>统一社会信用代码</dt><dd><span data-inline-edit-value>@(Model.Company.UnifiedSocialCreditCode ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.UnifiedSocialCreditCode" data-inline-edit-control hidden /> }</dd></div>
                    <div><dt>联系电话</dt><dd><span data-inline-edit-value>@(Model.Company.Phone ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.Phone" data-inline-edit-control hidden /> }</dd></div>
                    <div><dt>开票抬头</dt><dd><span data-inline-edit-value>@(Model.Company.InvoiceTitle ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.InvoiceTitle" data-inline-edit-control hidden /> }</dd></div>
                    <div><dt>注册地址</dt><dd><span data-inline-edit-value>@(Model.Company.RegisteredAddress ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.RegisteredAddress" data-inline-edit-control hidden /> }</dd></div>
                    <div><dt>经营地址</dt><dd><span data-inline-edit-value>@(Model.Company.BusinessAddress ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" asp-for="QuickEdit.BusinessAddress" data-inline-edit-control hidden /> }</dd></div>
                    <div><dt>备注</dt><dd><span data-inline-edit-value>@(Model.Company.Notes ?? "未填写")</span>@if (Model.CanManage) { <textarea class="inline-cell-control" asp-for="QuickEdit.Notes" data-inline-edit-control hidden></textarea> }</dd></div>
                </dl>
                @if (Model.CanManage) { <label class="inline-edit-reason" data-inline-edit-actions hidden>修改原因<input asp-for="QuickEdit.Reason" required /></label><input type="hidden" asp-for="QuickEdit.Id" /><input type="hidden" asp-for="QuickEdit.ConcurrencyStamp" /> }
            </form>
        </article>
    </section>
    @if (Model.CanManage)
    {
        <dialog class="workbench-dialog company-create-dialog company-dialog company-detailed-edit-dialog mac-window-dialog" data-company-detailed-edit-dialog data-dialog-open="@Model.DetailedEditOpen.ToString().ToLowerInvariant()" aria-labelledby="company-detailed-edit-title">
            <form method="post" asp-page-handler="DetailedEdit" asp-route-id="@Model.Company.Id">
                <div class="workbench-dialog-heading">
                    <span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
                    <div><strong id="company-detailed-edit-title">详细编辑公司</strong><span>维护主体、税务、地址与开票资料，修改历史由审计日志保留。</span></div>
                    <button class="dialog-close" type="button" data-company-detailed-edit-close aria-label="关闭详细编辑窗口">×</button>
                </div>
                <div class="company-create-dialog-body company-dialog-body company-dialog-form-grid company-detailed-edit-body form-grid">
                    <div asp-validation-summary="All" class="form-span validation-summary"></div>
                    <section class="form-section">
                        <h2 class="section-heading">主体资料</h2>
                        <label>公司编码<input name="QuickEdit.Code" value="@Model.QuickEdit.Code" required /></label>
                        <label>公司全称<input name="QuickEdit.Name" value="@Model.QuickEdit.Name" required /></label>
                        <label>公司简称<input name="QuickEdit.ShortName" value="@Model.QuickEdit.ShortName" required /></label>
                        <label>组合分类<select name="QuickEdit.CompanyCategoryId" required><option value="">请选择</option>@foreach (var category in Model.Categories.Where(x => x.IsActive)) { <option value="@category.Id" selected="@(Model.QuickEdit.CompanyCategoryId == category.Id ? "selected" : null)">@category.Name</option> }</select></label>
                        <label>状态<select name="QuickEdit.IsActive"><option value="true" selected="@(Model.QuickEdit.IsActive ? "selected" : null)">启用</option><option value="false" selected="@(!Model.QuickEdit.IsActive ? "selected" : null)">停用</option></select></label>
                        <label>法人/经营者<input name="QuickEdit.LegalRepresentative" value="@Model.QuickEdit.LegalRepresentative" /></label>
                        <label>统一社会信用代码/税号<input name="QuickEdit.UnifiedSocialCreditCode" value="@Model.QuickEdit.UnifiedSocialCreditCode" /></label>
                    </section>
                    <section class="form-section">
                        <h2 class="section-heading">地址与开票</h2>
                        <label>注册地址<input name="QuickEdit.RegisteredAddress" value="@Model.QuickEdit.RegisteredAddress" /></label>
                        <label>经营地址<input name="QuickEdit.BusinessAddress" value="@Model.QuickEdit.BusinessAddress" /></label>
                        <label>电话<input name="QuickEdit.Phone" value="@Model.QuickEdit.Phone" /></label>
                        <label>开票抬头<input name="QuickEdit.InvoiceTitle" value="@Model.QuickEdit.InvoiceTitle" /></label>
                        <label class="form-span">备注<textarea name="QuickEdit.Notes">@Model.QuickEdit.Notes</textarea></label>
                    </section>
                    <section class="form-section company-dialog-section--full">
                        <h2 class="section-heading">修改记录</h2>
                        <label class="form-span">修改原因<input name="QuickEdit.Reason" value="@Model.QuickEdit.Reason" required /></label>
                    </section>
                    <input name="QuickEdit.Id" value="@Model.Company.Id" type="hidden" />
                    <input name="QuickEdit.ConcurrencyStamp" value="@Model.QuickEdit.ConcurrencyStamp" type="hidden" />
                </div>
                <div class="workbench-dialog-actions">
                    <button class="button button--secondary" type="button" data-company-detailed-edit-close>取消</button>
                    <button class="button button--primary" type="submit">保存修改</button>
                </div>
            </form>
        </dialog>
    }
}
else if (Model.ActiveTab == "certificates")
{
    <datalist id="company-certificate-types"><option value="营业执照"></option><option value="安全生产许可证"></option><option value="资质证书"></option><option value="开户许可证"></option><option value="行业许可证"></option></datalist>
    <section class="panel inline-edit-shell" data-company-certificate-table data-inline-edit="company-certificates" data-inline-cell-edit data-inline-edit-active="@(Model.CertificateEditOpen ? "true" : "false")">
        <div class="panel-heading">
            <h2>证书信息</h2>
            @if (Model.CanManage)
            {
                <div class="button-row">
                    <button class="button button--secondary button--action" type="button" data-company-certificate-create-open data-inline-edit-value>新增证照</button>
                    @if (Model.Certificates.Count > 0)
                    {
                        <button class="button button--primary button--action" type="button" data-inline-edit-open data-inline-edit-value>快捷编辑</button>
                        <form id="certificate-batch-form" method="post" asp-page-handler="Certificates" asp-route-id="@Model.Company.Id" class="inline-form" data-inline-edit-actions hidden>
                            <button class="button button--primary button--action" type="submit">保存修改</button>
                        </form>
                        <button class="button button--secondary button--action" type="button" data-inline-edit-cancel data-inline-edit-actions hidden>取消编辑</button>
                    }
                </div>
            }
        </div>
        <div asp-validation-summary="All" class="panel-copy"></div>
        @if (Model.Certificates.Count == 0)
        {
            <p class="panel-copy">还没有维护公司证照。</p>
        }
        else
        {
            <div class="table-wrap company-certificate-table-wrap"><table class="data-table company-certificate-table"><thead><tr><th>证书类型</th><th>证书编号</th><th>专业/等级/资质范围</th><th>发证机关</th><th>签发日期</th><th>到期日期</th><th>到期状态</th><th>备注</th><th>附件</th></tr></thead><tbody>
            @for (var certificateIndex = 0; certificateIndex < Model.Certificates.Count; certificateIndex++)
            {
                var cert = Model.Certificates[certificateIndex];
                var certificateRow = Model.CertificateRows.FirstOrDefault(item => item.Id == cert.Id) ?? DetailsModel.CertificateRowInput.From(cert);
                var attachmentUploadFormId = $"company-certificate-attachment-{cert.Id:N}";
                var attachmentDeleteFormId = $"company-certificate-attachment-delete-{cert.Id:N}";
                string status;
                string badgeClass;
                if (!cert.ExpiresOn.HasValue) { status = "长期有效"; badgeClass = "status-badge status-badge--ok"; }
                else if (cert.ExpiresOn.Value < today) { status = "已过期"; badgeClass = "status-badge status-badge--danger"; }
                else if (cert.ExpiresOn.Value <= today.AddDays(30)) { status = "30天内"; badgeClass = "status-badge status-badge--warn"; }
                else if (cert.ExpiresOn.Value <= today.AddDays(60)) { status = "60天内"; badgeClass = "status-badge status-badge--warn"; }
                else if (cert.ExpiresOn.Value <= today.AddDays(90)) { status = "90天内"; badgeClass = "status-badge status-badge--warn"; }
                else { status = "正常"; badgeClass = "status-badge status-badge--ok"; }
                var attachmentContentType = System.IO.Path.GetExtension(cert.AttachmentFileName)?.ToLowerInvariant() switch
                {
                    ".jpg" or ".jpeg" => "image/jpeg",
                    ".png" => "image/png",
                    ".pdf" => "application/pdf",
                    _ => "application/octet-stream"
                };
                <tr>
                    <td>
                        <input type="hidden" name="CertificateRows[@certificateIndex].Id" value="@certificateRow.Id" form="certificate-batch-form" />
                        <input type="hidden" name="CertificateRows[@certificateIndex].ConcurrencyStamp" value="@certificateRow.ConcurrencyStamp" form="certificate-batch-form" />
                        <span data-inline-edit-value>@cert.CertificateType</span>
                        @if (Model.CanManage) { <input class="inline-cell-control" name="CertificateRows[@certificateIndex].Type" value="@certificateRow.Type" form="certificate-batch-form" data-inline-edit-control hidden required /> }
                    </td>
                    <td><span data-inline-edit-value>@(cert.CertificateNumber ?? "—")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="CertificateRows[@certificateIndex].Number" value="@certificateRow.Number" form="certificate-batch-form" data-inline-edit-control hidden /> }</td>
                    <td><span data-inline-edit-value>@(cert.SpecialtyLevelScope ?? "—")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="CertificateRows[@certificateIndex].SpecialtyLevelScope" value="@certificateRow.SpecialtyLevelScope" form="certificate-batch-form" data-inline-edit-control hidden /> }</td>
                    <td><span data-inline-edit-value>@(cert.IssuingAuthority ?? "—")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="CertificateRows[@certificateIndex].IssuingAuthority" value="@certificateRow.IssuingAuthority" form="certificate-batch-form" data-inline-edit-control hidden /> }</td>
                    <td><span data-inline-edit-value>@(cert.IssuedOn?.ToString("yyyy-MM-dd") ?? "—")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="CertificateRows[@certificateIndex].IssuedOn" value="@certificateRow.IssuedOn?.ToString("yyyy-MM-dd")" type="date" form="certificate-batch-form" data-inline-edit-control hidden /> }</td>
                    <td><span data-inline-edit-value>@(cert.ExpiresOn?.ToString("yyyy-MM-dd") ?? "长期有效")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="CertificateRows[@certificateIndex].ExpiresOn" value="@certificateRow.ExpiresOn?.ToString("yyyy-MM-dd")" type="date" form="certificate-batch-form" data-inline-edit-control hidden /> }</td>
                    <td><span class="@badgeClass">@status</span></td>
                    <td><span data-inline-edit-value>@(cert.Notes ?? "—")</span>@if (Model.CanManage) { <textarea class="inline-cell-control" name="CertificateRows[@certificateIndex].Notes" form="certificate-batch-form" data-inline-edit-control hidden>@certificateRow.Notes</textarea> }</td>
                    <td class="record-attachment-column">
                        <div class="record-attachment-tools">
                            @if (!cert.AttachmentId.HasValue)
                            {
                                @if (Model.CanManage)
                                {
                                    <form id="@attachmentUploadFormId" method="post" enctype="multipart/form-data" asp-page-handler="CertificateAttachment" asp-route-id="@Model.Company.Id" asp-route-certificateId="@cert.Id" data-auto-upload-picker>
                                        <input type="file" name="CertificateAttachmentFile" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.ppt,.pptx" required data-auto-upload-input hidden />
                                        <button class="button button--secondary button--small" type="button" data-auto-upload-trigger>上传</button>
                                    </form>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            }
                            else
                            {
                                <a class="attachment-file-link" data-attachment-preview-trigger asp-page-handler="CertificateAttachment" asp-route-id="@Model.Company.Id" asp-route-certificateId="@cert.Id" title="@cert.AttachmentFileName" data-attachment-name="@cert.AttachmentFileName" data-attachment-content-type="@attachmentContentType" data-attachment-can-manage="@Model.CanManage.ToString().ToLowerInvariant()" data-attachment-replace-form-id="@attachmentUploadFormId" data-attachment-delete-form-id="@attachmentDeleteFormId">@cert.AttachmentFileName</a>
                                @if (Model.CanManage)
                                {
                                    <form id="@attachmentUploadFormId" method="post" enctype="multipart/form-data" asp-page-handler="CertificateAttachment" asp-route-id="@Model.Company.Id" asp-route-certificateId="@cert.Id" data-auto-upload-picker hidden>
                                        <input type="file" name="CertificateAttachmentFile" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.ppt,.pptx" required data-auto-upload-input hidden />
                                        <button type="button" data-auto-upload-trigger hidden>替换</button>
                                    </form>
                                    <form id="@attachmentDeleteFormId" method="post" asp-page-handler="DeleteCertificateAttachment" asp-route-id="@Model.Company.Id" asp-route-certificateId="@cert.Id" hidden></form>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
    @if (Model.CanManage)
    {
        <dialog class="workbench-dialog company-create-dialog company-dialog mac-window-dialog" data-company-certificate-create-dialog data-dialog-open="@Model.CertificateCreateOpen.ToString().ToLowerInvariant()" aria-labelledby="company-certificate-create-title">
            <form method="post" enctype="multipart/form-data" asp-page-handler="Certificate" asp-route-id="@Model.Company.Id" asp-route-tab="certificates">
                <div class="workbench-dialog-heading">
                    <span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
                    <div><strong id="company-certificate-create-title">新增证照</strong><span>填写证照资料，可同时上传一份附件。</span></div>
                    <button class="dialog-close" type="button" data-company-create-dialog-close aria-label="关闭新增证照窗口">×</button>
                </div>
                <div class="company-create-dialog-body company-dialog-body company-dialog-form-grid form-grid">
                    <div asp-validation-summary="All" class="panel-copy form-span"></div>
                <label>证书类型<input asp-for="Certificate.Type" list="company-certificate-types" required /></label>
                <label>证书编号<input asp-for="Certificate.Number" /></label>
                <label>专业/等级/资质范围<input asp-for="Certificate.SpecialtyLevelScope" /></label>
                <label>发证机关<input asp-for="Certificate.IssuingAuthority" /></label>
                <label>签发日期<input asp-for="Certificate.IssuedOn" type="date" /></label>
                <label>到期日期<input asp-for="Certificate.ExpiresOn" type="date" /><small>留空表示长期有效</small></label>
                <label class="form-span">附件<input asp-for="CertificateAttachmentFile" type="file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.ppt,.pptx" /><small>单个附件最大 20MB。</small></label>
                <label class="form-span">备注<textarea asp-for="Certificate.Notes"></textarea></label>
                <label class="form-span">修改原因<input asp-for="Certificate.Reason" value="新增公司证照" required /></label>
                </div>
                <div class="quick-edit-actions">
                    <button class="button button--secondary" type="button" data-company-create-dialog-close>取消</button>
                    <button class="button button--primary" type="submit">确认新增</button>
                </div>
            </form>
        </dialog>
    }
    <dialog class="attachment-preview-dialog company-attachment-preview-dialog mac-window-dialog" data-attachment-preview-dialog aria-labelledby="company-certificate-attachment-preview-title">
        <div class="attachment-preview-shell">
            <header class="attachment-preview-toolbar">
                <span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong id="company-certificate-attachment-preview-title" data-attachment-preview-title>附件预览</strong>
                <div class="attachment-preview-actions">
                    <button class="button button--secondary button--small" type="button" data-attachment-preview-replace hidden>替换</button>
                    <button class="button button--secondary button--small attachment-preview-delete" type="button" data-attachment-preview-delete hidden>删除</button>
                    <a class="button button--secondary button--small" href="#" data-attachment-preview-download>下载</a>
                    <button class="button button--secondary button--small" type="button" data-attachment-preview-close>关闭</button>
                </div>
            </header>
            <div class="attachment-preview-body">
                <img data-attachment-preview-image alt="证书附件图片预览" hidden />
                <iframe data-attachment-preview-frame title="证书附件预览" hidden></iframe>
                <p data-attachment-preview-fallback hidden></p>
            </div>
        </div>
    </dialog>
}
else if (Model.ActiveTab == "accounts")
{
    <section class="panel inline-edit-shell" id="company-accounts" data-company-account-table data-inline-edit="company-accounts" data-inline-cell-edit data-inline-edit-active="@(Model.AccountEditOpen ? "true" : "false")">
        <div class="panel-heading">
            <div><h2>账户信息</h2><p class="panel-copy">当前启用 @Model.Company.Accounts.Count(account => account.IsActive) 个，共 @Model.Company.Accounts.Count 个。</p></div>
            @if (Model.CanManage)
            {
                <div class="button-row">
                    <button class="button button--secondary button--action" type="button" data-company-account-create-open data-inline-edit-value>新增账户</button>
                    @if (Model.Company.Accounts.Count > 0)
                    {
                        <button class="button button--primary button--action" type="button" data-inline-edit-open data-inline-edit-value>快捷编辑</button>
                        <form id="account-batch-form" method="post" asp-page-handler="Accounts" asp-route-id="@Model.Company.Id" class="inline-form" data-inline-edit-actions hidden>
                            <button class="button button--primary button--action" type="submit">保存修改</button>
                        </form>
                        <button class="button button--secondary button--action" type="button" data-inline-edit-cancel data-inline-edit-actions hidden>取消编辑</button>
                    }
                </div>
            }
        </div>
        <div asp-validation-summary="All" class="panel-copy"></div>
        @if (Model.Company.Accounts.Count == 0)
        {
            <p class="panel-copy">还没有维护公司账户。</p>
        }
        else
        {
            <div class="table-wrap"><table class="data-table company-account-table"><thead><tr><th>账户名称</th><th>账号</th><th>开户行</th><th>账户类型</th><th>期初余额</th><th>默认用途</th><th>状态</th><th>账户备注</th></tr></thead><tbody>
            @{ var accountIndex = 0; }
            @foreach (var account in Model.Company.Accounts.OrderByDescending(a => a.IsActive).ThenBy(a => a.AccountName))
            {
                var currentAccountIndex = accountIndex++;
                var accountRow = Model.AccountRows.FirstOrDefault(item => item.Id == account.Id) ?? DetailsModel.AccountRowInput.From(account);
                var accountTypeLabel = accountRow.AccountType switch
                {
                    (int)FinancialAccountType.Bank => "银行",
                    (int)FinancialAccountType.Cash => "现金",
                    _ => "其他"
                };
                var defaultLabels = new List<string>();
                if ((accountRow.DefaultPurpose & 1) != 0) defaultLabels.Add("收款");
                if ((accountRow.DefaultPurpose & 2) != 0) defaultLabels.Add("付款");
                if ((accountRow.DefaultPurpose & 4) != 0) defaultLabels.Add("开票");
                <tr class="@(accountRow.IsActive ? null : "is-account-inactive")">
                    <td>
                        <input type="hidden" name="AccountRows[@currentAccountIndex].Id" value="@accountRow.Id" form="account-batch-form" />
                        <input type="hidden" name="AccountRows[@currentAccountIndex].ConcurrencyStamp" value="@accountRow.ConcurrencyStamp" form="account-batch-form" />
                        <span data-inline-edit-value>@accountRow.Name</span>
                        @if (!accountRow.IsActive) { <span class="status-badge status-badge--muted" data-inline-edit-value>已停用</span> }
                        @if (Model.CanManage) { <input class="inline-cell-control" name="AccountRows[@currentAccountIndex].Name" value="@accountRow.Name" form="account-batch-form" data-inline-edit-control hidden required /> }
                    </td>
                    <td><span data-inline-edit-value>@(accountRow.Number ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="AccountRows[@currentAccountIndex].Number" value="@accountRow.Number" form="account-batch-form" data-inline-edit-control hidden /> }</td>
                    <td><span data-inline-edit-value>@(accountRow.BankName ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="AccountRows[@currentAccountIndex].BankName" value="@accountRow.BankName" form="account-batch-form" data-inline-edit-control hidden /> }</td>
                    <td><span data-inline-edit-value>@accountTypeLabel</span>@if (Model.CanManage) { <select class="inline-cell-control" name="AccountRows[@currentAccountIndex].AccountType" form="account-batch-form" data-inline-edit-control hidden><option value="1" selected="@(accountRow.AccountType == 1 ? "selected" : null)">银行</option><option value="2" selected="@(accountRow.AccountType == 2 ? "selected" : null)">现金</option><option value="3" selected="@(accountRow.AccountType == 3 ? "selected" : null)">其他</option></select> }</td>
                    <td><span data-inline-edit-value>@accountRow.OpeningBalance.ToString("N2")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="AccountRows[@currentAccountIndex].OpeningBalance" value="@accountRow.OpeningBalance" type="number" step="0.01" form="account-batch-form" data-inline-edit-control hidden /> }</td>
                    <td>
                        <span data-inline-edit-value>@(defaultLabels.Count == 0 ? "无" : string.Join("、", defaultLabels))</span>
                        @if (Model.CanManage)
                        {
                            <select class="inline-cell-control" name="AccountRows[@currentAccountIndex].DefaultPurpose" form="account-batch-form" data-inline-edit-control hidden>
                                <option value="0" selected="@(accountRow.DefaultPurpose == 0 ? "selected" : null)">无</option>
                                <option value="1" selected="@(accountRow.DefaultPurpose == 1 ? "selected" : null)">收款</option>
                                <option value="2" selected="@(accountRow.DefaultPurpose == 2 ? "selected" : null)">付款</option>
                                <option value="3" selected="@(accountRow.DefaultPurpose == 3 ? "selected" : null)">收款、付款</option>
                                <option value="4" selected="@(accountRow.DefaultPurpose == 4 ? "selected" : null)">开票</option>
                                <option value="5" selected="@(accountRow.DefaultPurpose == 5 ? "selected" : null)">收款、开票</option>
                                <option value="6" selected="@(accountRow.DefaultPurpose == 6 ? "selected" : null)">付款、开票</option>
                                <option value="7" selected="@(accountRow.DefaultPurpose == 7 ? "selected" : null)">收款、付款、开票</option>
                            </select>
                        }
                    </td>
                    <td>
                        <span class="status-badge @(accountRow.IsActive ? "status-badge--ok" : "status-badge--muted")" data-inline-edit-value>@(accountRow.IsActive ? "启用" : "已停用")</span>
                        @if (Model.CanManage) { <select class="inline-cell-control" name="AccountRows[@currentAccountIndex].IsActive" form="account-batch-form" data-inline-edit-control hidden><option value="true" selected="@(accountRow.IsActive ? "selected" : null)">启用</option><option value="false" selected="@(!accountRow.IsActive ? "selected" : null)">停用</option></select> }
                    </td>
                    <td><span data-inline-edit-value>@(accountRow.Notes ?? "未填写")</span>@if (Model.CanManage) { <input class="inline-cell-control" name="AccountRows[@currentAccountIndex].Notes" value="@accountRow.Notes" form="account-batch-form" data-inline-edit-control hidden /> }</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
    @if (Model.CanManage)
    {
        <dialog class="workbench-dialog company-create-dialog company-dialog mac-window-dialog" data-company-account-create-dialog data-dialog-open="@Model.AccountCreateOpen.ToString().ToLowerInvariant()" aria-labelledby="company-account-create-title">
            <form method="post" asp-page-handler="Account" asp-route-id="@Model.Company.Id" asp-route-tab="accounts">
                <div class="workbench-dialog-heading">
                    <span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
                    <div><strong id="company-account-create-title">新增账户</strong><span>填写账户资料，新账户保存后默认启用。</span></div>
                    <button class="dialog-close" type="button" data-company-create-dialog-close aria-label="关闭新增账户窗口">×</button>
                </div>
                <div class="company-create-dialog-body company-dialog-body company-dialog-form-grid form-grid">
                    <div asp-validation-summary="All" class="panel-copy form-span"></div>
                <input asp-for="Account.IsActive" type="hidden" value="true" />
                <label>账户名称<input asp-for="Account.Name" required /></label>
                <label>账户类型<select asp-for="Account.AccountType"><option value="1">银行</option><option value="2">现金</option><option value="3">其他</option></select></label>
                <label>账号<input asp-for="Account.Number" /></label>
                <label>开户行<input asp-for="Account.BankName" /></label>
                <label>期初余额<input asp-for="Account.OpeningBalance" /></label>
                <label>账户备注<textarea asp-for="Account.Notes"></textarea></label>
                <label class="checkbox-row"><input asp-for="Account.DefaultCollection" />默认收款</label>
                <label class="checkbox-row"><input asp-for="Account.DefaultPayment" />默认付款</label>
                <label class="checkbox-row"><input asp-for="Account.DefaultInvoice" />默认开票</label>
                </div>
                <div class="quick-edit-actions">
                    <button class="button button--secondary" type="button" data-company-create-dialog-close>取消</button>
                    <button class="button button--primary" type="submit">确认新增</button>
                </div>
            </form>
        </dialog>
    }
}
else if (Model.ActiveTab == "projects")
{
    <section class="panel">
        <div class="panel-heading">
            <div><h2>项目与合同</h2><p class="panel-copy">只读展示本公司关联项目与合同；点击名称进入项目管理编辑。</p></div>
            <a class="button button--secondary button--action" asp-page="/Projects/Index" asp-route-LegalEntityId="@Model.Company.Id">在项目管理中查看全部</a>
        </div>
        @if (Model.Projects.Count == 0)
        {
            <p class="panel-copy">本公司暂无关联项目或合同。</p>
        }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr><th>项目编号</th><th>项目名称</th><th>阶段</th><th>本公司合同额</th><th>应收 / 已收</th><th>应付 / 已付</th><th>操作</th></tr></thead><tbody>
            @foreach (var project in Model.Projects)
            {
                <tr>
                    <td><a asp-page="/Projects/Details" asp-route-id="@project.ProjectId">@project.ProjectNumber</a></td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@project.ProjectId">@project.ProjectName</a></td>
                    <td>@(Enum.TryParse<ProjectStage>(project.Stage, out var stage) ? stage.ToChinese() : project.Stage)</td>
                    <td>@project.CompanyContractAmount.ToString("N2")</td>
                    <td>@project.ReceivableAmount.ToString("N2") / @project.CollectedAmount.ToString("N2")</td>
                    <td>@project.PayableAmount.ToString("N2") / @project.PaidAmount.ToString("N2")</td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@project.ProjectId">打开项目</a></td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
    <section class="panel">
        <div class="panel-heading"><h2>合同明细</h2></div>
        @if (Model.Contracts.Count == 0)
        {
            <p class="panel-copy">本公司暂无合同分配记录。</p>
        }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr><th>合同编号</th><th>合同名称</th><th>合同总额</th><th>本公司份额</th><th>比例</th><th>状态</th></tr></thead><tbody>
            @foreach (var contract in Model.Contracts)
            {
                <tr>
                    <td><a asp-page="/Projects/Details" asp-route-id="@contract.ProjectId">@contract.ContractNumber</a></td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@contract.ProjectId">@contract.ContractName</a></td>
                    <td>@contract.ContractTotalAmount.ToString("N2")</td>
                    <td>@contract.CompanyShareAmount.ToString("N2")</td>
                    <td>@(contract.CompanySharePercentage?.ToString("N2") is string p ? p + "%" : "—")</td>
                    <td>@(contract.IsActive ? "有效" : "停用")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}
else if (Model.ActiveTab == "finance")
{
    <section class="panel">
        <div class="panel-heading"><div><h2>收款明细</h2><p class="panel-copy">本页只读汇总公司收付款与发票；点击项目或打开经营台账进行业务维护。</p></div><a class="button button--secondary button--action" asp-page="/Finance/Index">打开经营台账</a></div>
        @if (Model.Collections.Count == 0) { <p class="panel-copy">本公司暂无收款记录。</p> }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr><th>日期</th><th>项目</th><th>摘要</th><th>账户</th><th>金额</th></tr></thead><tbody>
            @foreach (var row in Model.Collections)
            {
                <tr>
                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@row.ProjectId">@row.ProjectNumber @row.ProjectName</a></td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@row.ProjectId">@row.Summary</a></td>
                    <td>@row.AccountName@if (!row.AccountIsActive) { <span class="status-badge status-badge--muted">已停用</span> }</td>
                    <td>@row.Amount.ToString("N2")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
    <section class="panel">
        <div class="panel-heading"><h2>付款明细</h2></div>
        @if (Model.Payments.Count == 0) { <p class="panel-copy">本公司暂无付款记录。</p> }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr><th>日期</th><th>项目</th><th>摘要</th><th>账户</th><th>金额</th></tr></thead><tbody>
            @foreach (var row in Model.Payments)
            {
                <tr>
                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@row.ProjectId">@row.ProjectNumber @row.ProjectName</a></td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@row.ProjectId">@row.Summary</a></td>
                    <td>@row.AccountName@if (!row.AccountIsActive) { <span class="status-badge status-badge--muted">已停用</span> }</td>
                    <td>@row.Amount.ToString("N2")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
    <section class="panel">
        <div class="panel-heading"><h2>发票明细</h2></div>
        @if (Model.Invoices.Count == 0) { <p class="panel-copy">本公司暂无发票记录。</p> }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr><th>方向</th><th>发票号</th><th>项目</th><th>开票公司</th><th>含税金额</th><th>日期</th></tr></thead><tbody>
            @foreach (var row in Model.Invoices)
            {
                <tr>
                    <td>@row.Direction</td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@row.ProjectId">@row.InvoiceNumber</a></td>
                    <td><a asp-page="/Projects/Details" asp-route-id="@row.ProjectId">@row.ProjectNumber @row.ProjectName</a></td>
                    <td>@row.LegalEntityName</td>
                    <td>@row.GrossAmount.ToString("N2")</td>
                    <td>@row.InvoiceDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}
</div>
