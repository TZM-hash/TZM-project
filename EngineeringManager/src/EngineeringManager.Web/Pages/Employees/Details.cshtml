@page
@model EngineeringManager.Web.Pages.Employees.DetailsModel
@using EngineeringManager.Domain.Employees
@using EngineeringManager.Domain.Finance
@using EngineeringManager.Domain.Certificates
@using EngineeringManager.Web.Presentation
@{
    ViewData["Title"] = "员工详情";
    var affiliation = Model.Employee.Affiliations.FirstOrDefault(item => item.IsPrimary);
    var personnelAffiliation = Model.PersonnelDetails?.CurrentAffiliation;
    var wageType = Model.WageSubtab switch { "attendance" => EmployeeWageEntryType.Attendance, "overtime" => EmployeeWageEntryType.Overtime, "bonus" => EmployeeWageEntryType.Bonus, "penalty" => EmployeeWageEntryType.Penalty, "other" => EmployeeWageEntryType.Other, _ => (EmployeeWageEntryType?)null };
    var wageRows = wageType.HasValue ? Model.WageEntries.Where(item => item.EntryType == wageType.Value).ToArray() : Model.WageEntries;
    var paymentCategory = Model.PaymentSubtab == "wage" ? PayrollPaymentCategory.Wage : Model.PaymentSubtab == "other" ? PayrollPaymentCategory.Other : (PayrollPaymentCategory?)null;
    var paymentRows = Model.Ledger?.ReceiptLines.Where(item => !paymentCategory.HasValue || item.PaymentCategory == paymentCategory.Value).ToArray() ?? [];
    var dividendType = Model.DividendSubtab switch { "dividend" => EmployeeLedgerEntryType.Dividend, "interest" => EmployeeLedgerEntryType.Interest, "other" => EmployeeLedgerEntryType.Other, _ => (EmployeeLedgerEntryType?)null };
    var otherRows = dividendType.HasValue ? Model.OtherPayables.Where(item => item.EntryType == dividendType.Value).ToArray() : Model.OtherPayables.ToArray();
}
@section Scripts { <script type="module" src="~/js/pages/personnel-affiliation.js" asp-append-version="true"></script> }

<div class="employee-project-detail-page">
<section class="page-heading compact-page-heading employee-detail-heading employee-detail-workspace project-detail-heading">
    <div><p class="eyebrow">@Model.Employee.EmployeeNumber</p><h1>@Model.Employee.Name</h1><p class="page-lead">@Model.Employee.EmployeeType.ToChinese() · @(Model.Employee.PositionTitle ?? affiliation?.PositionTitle ?? "未设置岗位") · @(affiliation?.LegalEntityName ?? "未归属公司") · @(affiliation?.DepartmentName ?? "未归属部门")</p></div>
    <div class="page-actions-inline"><nav class="project-detail-navigation employee-detail-navigation" aria-label="相邻员工切换">@if (Model.PreviousEmployeeId.HasValue) { <a class="button button--secondary button--action" asp-page="Details" asp-route-id="@Model.PreviousEmployeeId" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="@Model.Tab" asp-route-wageSubtab="@Model.WageSubtab" asp-route-paymentSubtab="@Model.PaymentSubtab" asp-route-dividendSubtab="@Model.DividendSubtab" asp-route-edit="@Model.Edit">上一页</a> } else { <span class="button button--secondary button--action project-detail-navigation-button--disabled" aria-disabled="true">上一页</span> }@if (Model.NextEmployeeId.HasValue) { <a class="button button--secondary button--action" asp-page="Details" asp-route-id="@Model.NextEmployeeId" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="@Model.Tab" asp-route-wageSubtab="@Model.WageSubtab" asp-route-paymentSubtab="@Model.PaymentSubtab" asp-route-dividendSubtab="@Model.DividendSubtab" asp-route-edit="@Model.Edit">下一页</a> } else { <span class="button button--secondary button--action project-detail-navigation-button--disabled" aria-disabled="true">下一页</span> }</nav><span class="status-chip @(Model.Employee.IsActive ? "status-chip--success" : "status-chip--muted")">@(Model.Employee.IsActive ? "启用" : "停用")</span>@if (Model.CanManageEmployee) { <a class="button button--primary button--action" asp-page="/Employees/Details" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-edit="profile">快捷编辑</a><a class="button button--secondary button--action" asp-page="/Employees/Create" asp-route-copyFrom="@Model.Id">复制员工</a> }</div>
</section>

<form method="get" class="employee-year-picker"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="tab" value="@Model.Tab" /><label>业务年度<select name="businessYearId" onchange="this.form.submit()">@foreach (var year in Model.BusinessYears) { <option value="@year.Id" selected="@(year.Id == Model.BusinessYearId ? "selected" : null)">@year.Name</option> }</select></label></form>

@if (Model.Ledger is not null)
{
    <section class="overview-strip employee-detail-overview employee-detail-metric-grid" aria-label="员工年度总账"><article class="employee-metric--carry"><span>往年结转</span><strong>@Model.Ledger.Summary.PriorYearCarryForward.ToString("N2")</strong></article><article class="employee-metric--wage"><span>工资应付</span><strong>@Model.Ledger.Summary.CurrentYearWagePayable.ToString("N2")</strong></article><article class="employee-metric--penalty"><span>罚款扣减</span><strong>@Model.PenaltyAmount.ToString("N2")</strong></article><article class="employee-metric--expense"><span>报销应付</span><strong>@Model.Ledger.Summary.ExpensePayable.ToString("N2")</strong></article><article class="employee-metric--other"><span>利息分红及其他应付</span><strong>@Model.Ledger.Summary.OtherPayable.ToString("N2")</strong></article><article class="employee-metric--payable"><span>本年新增应付</span><strong>@Model.Ledger.Summary.CurrentYearNewPayable.ToString("N2")</strong></article><article class="employee-metric--paid"><span>已付款</span><strong>@Model.Ledger.Summary.ReceivedAmount.ToString("N2")</strong></article><article class="employee-metric--balance @(Model.Ledger.Summary.IsOverpaid ? "is-danger" : null)"><span>当前余额</span><strong>@Model.Ledger.Summary.CurrentBalance.ToString("N2")</strong></article></section>
}

<div class="employee-detail-layout"><main>
<section class="panel employee-profile-panel project-summary-card inline-edit-shell" data-inline-edit="employee-profile" data-inline-cell-edit data-inline-edit-active="@Model.ProfileEditActive.ToString().ToLowerInvariant()">
    <div class="panel-heading"><div><p class="eyebrow">基础资料</p><h2>员工档案</h2></div>@if (Model.CanManageEmployee) { <button class="button button--secondary button--action" type="button" data-inline-edit-open>快捷编辑</button> }</div>
<div class="detail-grid employee-profile-grid"><div><span>员工编号</span><strong data-inline-edit-value>@Model.Employee.EmployeeNumber</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.EmployeeNumber" value="@Model.Employee.EmployeeNumber" hidden form="employee-profile-form" /></div><div><span>姓名</span><strong data-inline-edit-value>@Model.Employee.Name</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.Name" value="@Model.Employee.Name" hidden form="employee-profile-form" /></div><div><span>员工类型</span><strong>@Model.Employee.EmployeeType.ToChinese()</strong><input type="hidden" name="EmployeeInput.EmployeeType" value="@Model.Employee.EmployeeType" form="employee-profile-form" /></div><div><span>状态</span><strong data-inline-edit-value>@(Model.Employee.IsActive ? "启用" : "停用")</strong><select data-inline-edit-control class="inline-cell-control" name="EmployeeInput.IsActive" hidden form="employee-profile-form"><option value="true" selected="@(Model.Employee.IsActive ? "selected" : null)">启用</option><option value="false" selected="@(!Model.Employee.IsActive ? "selected" : null)">停用</option></select></div><div><span>是否作为项目负责人</span><strong data-inline-edit-value>@(Model.Employee.IsProjectResponsible ? "可以" : "不可以")</strong><select data-inline-edit-control class="inline-cell-control" name="EmployeeInput.IsProjectResponsible" hidden form="employee-profile-form"><option value="true" selected="@(Model.Employee.IsProjectResponsible ? "selected" : null)">可以</option><option value="false" selected="@(!Model.Employee.IsProjectResponsible ? "selected" : null)">不可以</option></select></div><div><span>岗位</span><strong>@(Model.Employee.PositionTitle ?? "未填写")</strong><input type="hidden" name="EmployeeInput.PositionTitle" value="@Model.Employee.PositionTitle" form="employee-profile-form" /></div><div><span>电话</span><strong data-inline-edit-value>@(Model.Employee.Phone ?? "未填写")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.Phone" value="@Model.Employee.Phone" hidden form="employee-profile-form" /></div><div><span>身份证</span><strong data-inline-edit-value>@(Model.Employee.IdentityNumber ?? "未填写")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.IdentityNumber" value="@Model.Employee.IdentityNumber" hidden form="employee-profile-form" /></div><div><span>银行卡</span><strong data-inline-edit-value>@(Model.Employee.BankAccountNumber ?? "未填写")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.BankAccountNumber" value="@Model.Employee.BankAccountNumber" hidden form="employee-profile-form" /></div><div><span>开户行</span><strong data-inline-edit-value>@(Model.Employee.BankName ?? "未填写")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.BankName" value="@Model.Employee.BankName" hidden form="employee-profile-form" /></div><div><span>入职日期</span><strong data-inline-edit-value>@(Model.Employee.HireDate?.ToString("yyyy-MM-dd") ?? "未填写")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.HireDate" value="@Model.Employee.HireDate?.ToString("yyyy-MM-dd")" type="date" hidden form="employee-profile-form" /></div><div><span>离职日期</span><strong data-inline-edit-value>@(Model.Employee.LeaveDate?.ToString("yyyy-MM-dd") ?? "未填写")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.LeaveDate" value="@Model.Employee.LeaveDate?.ToString("yyyy-MM-dd")" type="date" hidden form="employee-profile-form" /></div><div><span>默认月薪</span><strong data-inline-edit-value>@(Model.Employee.DefaultMonthlySalary?.ToString("N2") ?? "未设置")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.DefaultMonthlySalary" value="@Model.Employee.DefaultMonthlySalary" type="number" step="0.01" hidden form="employee-profile-form" /></div><div><span>默认日薪</span><strong data-inline-edit-value>@(Model.Employee.DefaultDailyRate?.ToString("N2") ?? "未设置")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.DefaultDailyRate" value="@Model.Employee.DefaultDailyRate" type="number" step="0.01" hidden form="employee-profile-form" /></div><div><span>默认时薪</span><strong data-inline-edit-value>@(Model.Employee.DefaultHourlyRate?.ToString("N2") ?? "未设置")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.DefaultHourlyRate" value="@Model.Employee.DefaultHourlyRate" type="number" step="0.01" hidden form="employee-profile-form" /></div><div><span>默认计件单价</span><strong data-inline-edit-value>@(Model.Employee.DefaultPieceworkRate?.ToString("N4") ?? "未设置")</strong><input data-inline-edit-control class="inline-cell-control" name="EmployeeInput.DefaultPieceworkRate" value="@Model.Employee.DefaultPieceworkRate" type="number" step="0.0001" hidden form="employee-profile-form" /></div></div>
    <p class="employee-dialog-note">员工类型、岗位和默认公司请在统一人员档案的当前归属中维护。</p>
    @if (Model.PersonId.HasValue && personnelAffiliation is not null)
    {
        <section class="personnel-affiliation-editor" data-personnel-affiliation data-personnel-scope="@personnelAffiliation.Scope" data-personnel-external-type="@personnelAffiliation.ExternalType">
            <div class="personnel-affiliation-heading"><div><span>当前归属</span><strong>按最新生效记录自动读取</strong></div><small>@personnelAffiliation.StartDate.ToString("yyyy-MM-dd") 起生效</small></div>
            @if (Model.CanManageEmployee)
            {
                <form id="personnel-affiliation-form" method="post" asp-page-handler="SaveAffiliation" class="personnel-affiliation-form">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="BusinessYearId" value="@Model.BusinessYearId" />
                    <input type="hidden" name="Tab" value="@Model.Tab" />
                    <input type="hidden" name="WageSubtab" value="@Model.WageSubtab" />
                    <input type="hidden" name="PaymentSubtab" value="@Model.PaymentSubtab" />
                    <input type="hidden" name="DividendSubtab" value="@Model.DividendSubtab" />
                    <input type="hidden" name="AffiliationInput.LegalEntityId" value="@Model.AffiliationInput.LegalEntityId" data-affiliation-legal-entity />
                    <input type="hidden" name="AffiliationInput.BusinessPartnerId" value="@Model.AffiliationInput.BusinessPartnerId" data-affiliation-business-partner />
                    <input type="hidden" name="AffiliationInput.ConcurrencyStamp" value="@Model.AffiliationInput.ConcurrencyStamp" />
                    <label><span>当前公司 / 单位</span><select name="AffiliationInput.OwnerKey" data-affiliation-owner required>
                        <option value="">请选择公司或单位</option>
                        <optgroup label="自有公司">
                        @foreach (var item in Model.AffiliationOptions.LegalEntities)
                        {
                            var ownerKey = $"legal:{item.Id}";
                            if (Model.AffiliationInput.OwnerKey == ownerKey) { <option value="@ownerKey" data-owner-scope="Internal" data-legal-entity-id="@item.Id" data-business-partner-id="" data-role="company" selected>@item.Name</option> }
                            else { <option value="@ownerKey" data-owner-scope="Internal" data-legal-entity-id="@item.Id" data-business-partner-id="" data-role="company">@item.Name</option> }
                        }
                        </optgroup>
                        <optgroup label="合作单位 / 施工班组">
                        @foreach (var item in Model.AffiliationOptions.BusinessPartners)
                        {
                            var ownerKey = $"partner:{item.Id}";
                            if (Model.AffiliationInput.OwnerKey == ownerKey) { <option value="@ownerKey" data-owner-scope="External" data-legal-entity-id="" data-business-partner-id="@item.Id" data-role="@(item.IsCrew ? "crew" : "partner")" selected>@item.Name</option> }
                            else { <option value="@ownerKey" data-owner-scope="External" data-legal-entity-id="" data-business-partner-id="@item.Id" data-role="@(item.IsCrew ? "crew" : "partner")">@item.Name</option> }
                        }
                        </optgroup>
                    </select></label>
                    <label><span>当前部门</span><select name="AffiliationInput.OrganizationUnitId" data-affiliation-department>
                        <option value="">未归属部门</option>
                        @foreach (var item in Model.AffiliationOptions.Departments)
                        {
                            if (Model.AffiliationInput.OrganizationUnitId == item.Id) { <option value="@item.Id" data-legal-entity-id="@item.LegalEntityId" data-business-partner-id="@item.BusinessPartnerId" selected>@item.Name</option> }
                            else { <option value="@item.Id" data-legal-entity-id="@item.LegalEntityId" data-business-partner-id="@item.BusinessPartnerId">@item.Name</option> }
                        }
                    </select></label>
                    <label><span>当前项目</span><select name="AffiliationInput.ProjectId" data-affiliation-project>
                        <option value="">未归属项目</option>
                        @foreach (var item in Model.AffiliationOptions.Projects)
                        {
                            var legalEntityIds = string.Join(",", item.LegalEntityIds);
                            var businessPartnerIds = string.Join(",", item.BusinessPartnerIds);
                            if (Model.AffiliationInput.ProjectId == item.Id) { <option value="@item.Id" data-legal-entity-id="@legalEntityIds" data-business-partner-id="@businessPartnerIds" selected>@item.Name</option> }
                            else { <option value="@item.Id" data-legal-entity-id="@legalEntityIds" data-business-partner-id="@businessPartnerIds">@item.Name</option> }
                        }
                    </select><small>自动读取最新生效项目；修改后旧归属保留在历史记录中。</small></label>
                    <label><span>当前班组</span><select name="AffiliationInput.CrewBusinessPartnerId" data-affiliation-crew>
                        <option value="">未归属班组</option>
                        @foreach (var item in Model.AffiliationOptions.Crews)
                        {
                            if (Model.AffiliationInput.CrewBusinessPartnerId == item.Id) { <option value="@item.Id" data-legal-entity-id="" data-business-partner-id="@item.Id" data-role="crew" selected>@item.Name</option> }
                            else { <option value="@item.Id" data-legal-entity-id="" data-business-partner-id="@item.Id" data-role="crew">@item.Name</option> }
                        }
                    </select></label>
                    <label><span>岗位</span><input name="AffiliationInput.PositionTitle" value="@Model.AffiliationInput.PositionTitle" /></label>
                    <label><span>生效日期</span><input type="date" name="AffiliationInput.EffectiveDate" value="@Model.AffiliationInput.EffectiveDate.ToString("yyyy-MM-dd")" required /></label>
                    <label class="personnel-affiliation-reason"><span>修改原因</span><input name="AffiliationInput.Reason" value="@Model.AffiliationInput.Reason" required /></label>
                    <div class="personnel-affiliation-actions"><a class="button button--secondary button--small" asp-page="/Personnel/Details" asp-route-personId="@Model.PersonId">查看归属历史</a><button class="button button--primary button--small" type="submit">保存当前归属</button></div>
                </form>
            }
            else
            {
                <div class="personnel-affiliation-readonly"><div><span>当前公司 / 单位</span><strong>@(personnelAffiliation.LegalEntityName ?? personnelAffiliation.BusinessPartnerName ?? "未归属")</strong></div><div><span>当前部门</span><strong>@(personnelAffiliation.OrganizationUnitName ?? "未归属")</strong></div><div><span>当前项目</span><strong>@(personnelAffiliation.ProjectName ?? "未归属")</strong></div><div><span>当前班组</span><strong>@(personnelAffiliation.CrewBusinessPartnerName ?? "未归属")</strong></div></div>
            }
        </section>
    }
    @if (Model.CanManageEmployee) { <form id="employee-profile-form" method="post" asp-page-handler="UpdateEmployee" class="inline-edit-actions" data-inline-edit-actions hidden><input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="BusinessYearId" value="@Model.BusinessYearId" /><input type="hidden" name="Tab" value="@Model.Tab" /><input type="hidden" name="Edit" value="profile" /><input type="hidden" name="EmployeeInput.DefaultLegalEntityId" value="@Model.Employee.DefaultLegalEntityId" /><input type="hidden" name="EmployeeInput.ConcurrencyStamp" value="@Model.Employee.ConcurrencyStamp" /><label>修改原因<input name="EmployeeInput.Reason" value="快捷编辑员工资料" required /></label><button class="button button--secondary button--small" type="button" data-inline-edit-cancel>取消</button><button class="button button--primary button--small" type="submit">保存修改</button></form> }
</section>
    <nav class="page-tabs employee-main-tabs" aria-label="员工详情标签">
        <a data-employee-main-tab class="@(Model.Tab == "wages" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="wages">工资明细</a>
        <a data-employee-main-tab class="@(Model.Tab == "expenses" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="expenses">报销明细</a>
        <a data-employee-main-tab class="@(Model.Tab == "dividends" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="dividends">利息分红</a>
        <a data-employee-main-tab class="@(Model.Tab == "payments" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="payments">付款记录</a>
        <a data-employee-main-tab class="@(Model.Tab == "certificates" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="certificates">证书管理</a>
    </nav>

    <section class="panel employee-tab-panel" data-employee-tab-panel="wages" hidden="@(Model.Tab == "wages" ? null : "hidden")">
        <div class="subtabs" role="tablist"><a class="@(Model.WageSubtab == "all" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="wages" asp-route-wageSubtab="all">全部</a><a class="@(Model.WageSubtab == "attendance" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="wages" asp-route-wageSubtab="attendance">考勤工资</a><a class="@(Model.WageSubtab == "overtime" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="wages" asp-route-wageSubtab="overtime">加班工资</a><a class="@(Model.WageSubtab == "bonus" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="wages" asp-route-wageSubtab="bonus">奖金</a><a class="@(Model.WageSubtab == "penalty" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="wages" asp-route-wageSubtab="penalty">罚款</a><a class="@(Model.WageSubtab == "other" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="wages" asp-route-wageSubtab="other">其他</a></div>
        <div class="overview-strip employee-wage-summary"><article><span>工资应付合计</span><strong>@wageRows.Sum(item => item.FinalAmount).ToString("N2")</strong></article><article><span>系统自动记录</span><strong>@wageRows.Count(item => item.IsSystemGenerated)</strong></article></div>
        @if (Model.CanEditFinancial) { <details class="workspace-create"><summary class="button button--secondary">新增工资明细</summary><form method="post" enctype="multipart/form-data" asp-page-handler="AddWage" class="form-grid"><label>开始日期<input asp-for="WageInput.StartDate" type="date" /></label><label>结束日期<input asp-for="WageInput.EndDate" type="date" /></label><label>分类<select asp-for="WageInput.EntryType"><option value="1">考勤工资</option><option value="2">加班工资</option><option value="3">奖金</option><option value="4">罚款</option><option value="5">其他</option></select></label><label>工资性质<select asp-for="WageInput.WageCategory"><option value="1">社保工资</option><option value="2">民工工资</option><option value="3">其他工资</option></select></label><label>单位<input asp-for="WageInput.Unit" /></label><label>手工金额<input asp-for="WageInput.ManualAmount" type="number" step="0.01" /></label><label>公司<select asp-for="WageInput.LegalEntityId"><option value="">未归属</option>@foreach (var item in Model.LegalEntities) { <option value="@item.Id">@item.ShortName</option> }</select></label><label>项目<select asp-for="WageInput.ProjectId"><option value="">未归属</option>@foreach (var item in Model.Projects) { <option value="@item.Project.Id">@item.Project.Name</option> }</select></label><label>劳务公司<select asp-for="WageInput.LaborBusinessPartnerId"><option value="">未填写</option>@foreach (var item in Model.LaborPartners) { <option value="@item.Id">@item.Name</option> }</select></label><label>附件<input asp-for="WageInput.Attachment" type="file" /></label><label>备注<textarea asp-for="WageInput.Notes"></textarea></label><button class="button button--primary" type="submit">保存</button></form></details> }
        <div class="table-wrap"><table class="data-table"><thead><tr><th>日期</th><th>分类</th><th>工资性质</th><th>公司</th><th>项目/劳务公司</th><th>金额</th><th>附件</th><th>备注</th><th>操作</th></tr></thead><tbody>@foreach (var row in wageRows) { <tr class="@(row.IsSystemGenerated ? "is-system-generated" : null)" data-inline-edit data-inline-cell-edit><td>@row.StartDate - @row.EndDate</td><td>@EmployeeDisplayText.WageEntryType(row.EntryType)</td><td>@EmployeeDisplayText.WageCategory(row.WageCategory)</td><td>@(row.LegalEntityName ?? "未归属")</td><td>@(row.ProjectName ?? row.LaborBusinessPartnerName ?? "未归属")</td><td class="numeric-cell">@row.FinalAmount.ToString("N2")</td><td>@(row.AttachmentFileName ?? "无")</td><td>@(row.Notes ?? "")</td><td>@if (row.IsSystemGenerated && row.SourcePersonalAdvanceBatchId.HasValue) { <a asp-page="/Payroll/Edit" asp-route-id="@row.SourcePersonalAdvanceBatchId" asp-route-returnUrl="@($"/Employees/Details?id={Model.Id}&businessYearId={Model.BusinessYearId}&tab=wages")">查看来源批次</a> } else if (Model.CanEditFinancial) { <button class="button button--secondary button--small" type="button" data-inline-edit-open>编辑</button><form method="post" asp-page-handler="UpdateWage" class="inline-row-form" data-inline-edit-actions hidden><input type="hidden" name="WageEdit.Id" value="@row.Id" /><input type="hidden" name="WageEdit.ConcurrencyStamp" value="@row.ConcurrencyStamp" /><input type="hidden" name="WageEdit.StartDate" value="@row.StartDate.ToString("yyyy-MM-dd")" /><input type="hidden" name="WageEdit.EndDate" value="@row.EndDate.ToString("yyyy-MM-dd")" /><input type="hidden" name="WageEdit.EntryType" value="@row.EntryType" /><input type="hidden" name="WageEdit.WageCategory" value="@row.WageCategory" /><input type="hidden" name="WageEdit.CalculationMethod" value="1" /><input type="hidden" name="WageEdit.Nature" value="@row.Nature" /><input type="hidden" name="WageEdit.ManualAmount" value="@Math.Abs(row.FinalAmount)" /><input type="hidden" name="WageEdit.LegalEntityId" value="@row.LegalEntityId" /><input type="hidden" name="WageEdit.ProjectId" value="@row.ProjectId" /><input type="hidden" name="WageEdit.LaborBusinessPartnerId" value="@row.LaborBusinessPartnerId" /><input type="hidden" name="WageEdit.AdjustmentAmount" value="0" /><input name="WageEdit.Notes" value="@row.Notes" /><input name="WageEdit.Reason" value="修改工资明细" /><button class="button button--secondary button--small" type="button" data-inline-edit-cancel>取消</button><button class="button button--primary button--small" type="submit">保存</button></form> }</td></tr> }</tbody></table></div>
    </section>

    <section class="panel employee-tab-panel" data-employee-tab-panel="expenses" hidden="@(Model.Tab == "expenses" ? null : "hidden")"><div class="overview-strip"><article class="is-accent"><span>报销总金额</span><strong>@Model.Expenses.Sum(item => item.Amount).ToString("N2")</strong></article></div>@if (Model.CanEditFinancial) { <details class="workspace-create"><summary class="button button--secondary">新增报销</summary><form method="post" enctype="multipart/form-data" asp-page-handler="AddExpense" class="form-grid"><label>报销日期<input asp-for="ExpenseInput.ExpenseDate" type="date" /></label><label>报销金额<input asp-for="ExpenseInput.Amount" type="number" step="0.01" /></label><label>项目<select asp-for="ExpenseInput.ProjectId"><option value="">未归属</option>@foreach (var item in Model.Projects) { <option value="@item.Project.Id">@item.Project.Name</option> }</select></label><label>公司<select asp-for="ExpenseInput.LegalEntityId">@foreach (var item in Model.LegalEntities) { <option value="@item.Id">@item.ShortName</option> }</select></label><label>票据号<input asp-for="ExpenseInput.ReceiptNumber" /></label><label>附件<input asp-for="ExpenseInput.Attachment" type="file" /></label><label>备注<textarea asp-for="ExpenseInput.Notes"></textarea></label><button class="button button--primary" type="submit">保存</button></form></details> }<div class="table-wrap"><table class="data-table"><thead><tr><th>报销日期</th><th>报销金额</th><th>项目</th><th>票据号</th><th>附件</th><th>备注</th><th>操作</th></tr></thead><tbody>@foreach (var row in Model.Expenses) { <tr data-inline-edit data-inline-cell-edit><td>@row.ExpenseDate</td><td class="numeric-cell">@row.Amount.ToString("N2")</td><td>@(row.ProjectName ?? "未归属")</td><td>@(row.ReceiptNumber ?? "")</td><td>@(row.AttachmentFileName ?? "无")</td><td>@(row.Description ?? "")</td><td>@if (Model.CanEditFinancial) { <button class="button button--secondary button--small" type="button" data-inline-edit-open>编辑</button><form method="post" asp-page-handler="UpdateExpense" class="inline-row-form" data-inline-edit-actions hidden><input type="hidden" name="ExpenseEdit.Id" value="@row.Id" /><input type="hidden" name="ExpenseEdit.ConcurrencyStamp" value="@row.ConcurrencyStamp" /><input type="hidden" name="ExpenseEdit.ExpenseDate" value="@row.ExpenseDate.ToString("yyyy-MM-dd")" /><input name="ExpenseEdit.Amount" value="@row.Amount" type="number" step="0.01" /><input type="hidden" name="ExpenseEdit.ProjectId" value="@row.ProjectId" /><input name="ExpenseEdit.ReceiptNumber" value="@row.ReceiptNumber" /><input name="ExpenseEdit.Description" value="@row.Description" /><input name="ExpenseEdit.Reason" value="修改报销金额" /><button class="button button--secondary button--small" type="button" data-inline-edit-cancel>取消</button><button class="button button--primary button--small" type="submit">保存</button></form> }</td></tr> }</tbody></table></div></section>

    <section class="panel employee-tab-panel" data-employee-tab-panel="dividends" hidden="@(Model.Tab == "dividends" ? null : "hidden")"><div class="subtabs" role="tablist"><a class="@(Model.DividendSubtab == "all" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="dividends" asp-route-dividendSubtab="all">全部</a><a class="@(Model.DividendSubtab == "dividend" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="dividends" asp-route-dividendSubtab="dividend">分红</a><a class="@(Model.DividendSubtab == "interest" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="dividends" asp-route-dividendSubtab="interest">利息</a><a class="@(Model.DividendSubtab == "other" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="dividends" asp-route-dividendSubtab="other">其他应付</a></div>@if (Model.CanEditFinancial) { <details class="workspace-create"><summary class="button button--secondary">新增利息分红</summary><form method="post" asp-page-handler="AddOtherPayable" class="form-grid"><label>日期<input asp-for="OtherInput.EntryDate" type="date" /></label><label>类型<select asp-for="OtherInput.EntryType"><option value="4">分红</option><option value="5">利息</option><option value="6">其他应付</option></select></label><label>金额<input asp-for="OtherInput.Amount" type="number" step="0.01" /></label><label>公司<select asp-for="OtherInput.LegalEntityId">@foreach (var item in Model.LegalEntities) { <option value="@item.Id">@item.ShortName</option> }</select></label><label>项目<select asp-for="OtherInput.ProjectId"><option value="">未归属</option>@foreach (var item in Model.Projects) { <option value="@item.Project.Id">@item.Project.Name</option> }</select></label><label>备注<textarea asp-for="OtherInput.Description"></textarea></label><button class="button button--primary" type="submit">保存</button></form></details> }<div class="table-wrap"><table class="data-table"><thead><tr><th>日期</th><th>类型</th><th>金额</th><th>公司</th><th>项目</th><th>备注</th><th>操作</th></tr></thead><tbody>@foreach (var row in otherRows) { <tr data-inline-edit data-inline-cell-edit><td>@row.EntryDate</td><td>@(row.EntryType == EmployeeLedgerEntryType.Dividend ? "分红" : row.EntryType == EmployeeLedgerEntryType.Interest ? "利息" : "其他应付")</td><td class="numeric-cell">@row.Amount.ToString("N2")</td><td>@row.LegalEntityName</td><td>@(row.ProjectName ?? "未归属")</td><td>@(row.Description ?? "")</td><td>@if (Model.CanEditFinancial) { <button class="button button--secondary button--small" type="button" data-inline-edit-open>编辑</button><form method="post" asp-page-handler="UpdateOtherPayable" class="inline-row-form" data-inline-edit-actions hidden><input type="hidden" name="OtherEdit.Id" value="@row.Id" /><input type="hidden" name="OtherEdit.ConcurrencyStamp" value="@row.ConcurrencyStamp" /><input type="hidden" name="OtherEdit.EntryDate" value="@row.EntryDate.ToString("yyyy-MM-dd")" /><input name="OtherEdit.Amount" value="@row.Amount" type="number" step="0.01" /><input name="OtherEdit.EntryType" value="@row.EntryType" /><input type="hidden" name="OtherEdit.LegalEntityId" value="@row.LegalEntityId" /><input type="hidden" name="OtherEdit.ProjectId" value="@row.ProjectId" /><input name="OtherEdit.Description" value="@row.Description" /><input name="OtherEdit.Reason" value="修改利息分红" /><button class="button button--secondary button--small" type="button" data-inline-edit-cancel>取消</button><button class="button button--primary button--small" type="submit">保存</button></form> }</td></tr> }</tbody></table></div></section>

    <section class="panel employee-tab-panel" data-employee-tab-panel="payments" hidden="@(Model.Tab == "payments" ? null : "hidden")"><div class="subtabs" role="tablist"><a class="@(Model.PaymentSubtab == "all" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="payments" asp-route-paymentSubtab="all">全部</a><a class="@(Model.PaymentSubtab == "wage" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="payments" asp-route-paymentSubtab="wage">工资</a><a class="@(Model.PaymentSubtab == "other" ? "is-active" : null)" asp-route-id="@Model.Id" asp-route-businessYearId="@Model.BusinessYearId" asp-route-tab="payments" asp-route-paymentSubtab="other">其他</a></div><p class="panel-copy">付款记录由工资台账和中央账本维护，本页只供查看。</p><div class="table-wrap"><table class="data-table"><thead><tr><th>付款日期</th><th>类别</th><th>来源</th><th>收款人</th><th>金额</th><th>备注</th><th>操作</th></tr></thead><tbody>@foreach (var row in paymentRows) { <tr><td>@row.ReceiptDate</td><td>@EmployeeDisplayText.PaymentCategory(row.PaymentCategory)</td><td>@row.SourceType</td><td>@(row.Recipient ?? "未填写")</td><td class="numeric-cell">@row.Amount.ToString("N2")</td><td>@(row.Notes ?? "")</td><td>@if (row.PayrollBatchId.HasValue) { <a asp-page="/Payroll/Edit" asp-route-id="@row.PayrollBatchId" asp-route-lineId="@row.PayrollPaymentId" asp-route-returnUrl="@($"/Employees/Details?id={Model.Id}&businessYearId={Model.BusinessYearId}&tab=payments")">查看来源批次</a> }</td></tr> }</tbody></table></div></section>

    <section class="panel employee-tab-panel" data-employee-tab-panel="certificates" hidden="@(Model.Tab == "certificates" ? null : "hidden")"><div class="panel-heading"><div><p class="eyebrow">证书资料</p><h2>证书管理</h2></div>@if (Model.CanManageEmployee) { <a class="button button--secondary button--action" asp-page="/Employees/Certificates/Edit" asp-route-employeeId="@Model.Id">新增证书</a> }</div><div class="overview-strip certificate-summary" aria-label="证书摘要"><article><span>证书摘要</span><strong>@Model.Certificates.Count</strong></article><article><span>已过期</span><strong>@Model.Certificates.Count(item => item.State == CertificateExpiryState.Expired)</strong></article><article><span>三个月内到期</span><strong>@Model.Certificates.Count(item => item.State is CertificateExpiryState.Info or CertificateExpiryState.Warning or CertificateExpiryState.Critical)</strong></article></div><div class="table-wrap"><table class="data-table"><thead><tr><th>证书</th><th>编号</th><th>有效期</th><th>状态</th><th>备注</th><th>操作</th></tr></thead><tbody>@foreach (var certificate in Model.Certificates) { <tr><td>@certificate.CertificateType</td><td>@certificate.CertificateNumber</td><td>@(certificate.ExpiresOn?.ToString("yyyy-MM-dd") ?? "长期有效")</td><td>@(certificate.State switch { CertificateExpiryState.LongTerm => "长期有效", CertificateExpiryState.Normal => "有效", CertificateExpiryState.Info => "轻度提醒", CertificateExpiryState.Warning => "中度提醒", CertificateExpiryState.Critical => "高度提醒", CertificateExpiryState.Expired => "已过期", _ => "未知" })</td><td>@certificate.Notes</td><td>@if (Model.CanManageEmployee) { <a asp-page="/Employees/Certificates/Edit" asp-route-id="@certificate.Id">编辑</a> }</td></tr> }</tbody></table></div></section>
</main>
@* The activity rail combines risk prompts with the employee's historical records. *@
<aside class="panel employee-activity-rail project-activity-panel"><div class="activity-panel-heading"><div><p class="eyebrow">动态</p><h2>提示与记录</h2></div><span>@((Model.Ledger?.PayableLines.Count ?? 0) + Model.WageEntries.Count)</span></div><div class="activity-feed">@if (Model.Ledger?.Summary.IsOverpaid == true) { <article class="activity-item activity-item--warning"><span class="activity-dot"></span><div><p class="activity-meta">经营提示</p><h3>存在超付或负余额</h3><p>当前余额 @Model.Ledger.Summary.CurrentBalance.ToString("N2")，请核对付款来源。</p></div></article> } @if (string.IsNullOrWhiteSpace(Model.Employee.Phone) || affiliation is null) { <article class="activity-item activity-item--warning"><span class="activity-dot"></span><div><p class="activity-meta">资料提示</p><h3>员工资料待完善</h3><p>@(string.IsNullOrWhiteSpace(Model.Employee.Phone) ? "联系电话未填写。" : "当前归属未设置。")</p></div></article> } @foreach (var item in (Model.Ledger?.PayableLines.Where(item => item.Category == AnnualLedgerEntryCategory.Adjustment || item.Category == AnnualLedgerEntryCategory.OpeningBalance).OrderByDescending(item => item.EntryDate).Take(8) ?? [])) { <article class="activity-item activity-item--info"><span class="activity-dot"></span><div><p class="activity-meta">@item.EntryDate</p><h3>@item.SourceType</h3><p>@item.Description</p><small>@item.Amount.ToString("N2")</small></div></article> } @foreach (var item in Model.WageEntries.Where(item => item.IsSystemGenerated).Take(8)) { <article class="activity-item activity-item--info"><span class="activity-dot"></span><div><p class="activity-meta">@item.StartDate</p><h3>个人垫付来源</h3><p>@item.Notes</p><small>@item.FinalAmount.ToString("N2")</small></div></article> }</div></aside></div>
</div>
