@page
@using EngineeringManager.Domain.Finance
@model EngineeringManager.Web.Pages.Ledger.Entries.EditModel
@{
    ViewData["Title"] = Model.IsEditing ? "编辑中央账本记录" : "新增中央账本记录";
}

<section class="page-heading compact-page-heading ledger-entry-page-heading">
    <div><p class="eyebrow">中央账本 · @(Model.Scope == LedgerScope.Internal ? "内部账本" : "外部账本")</p><h1>@(Model.IsEditing ? "编辑中央账本记录" : "新增中央账本记录")</h1><p class="page-lead">所有记录共享中央账本底层事实，来源模块生成的记录在此只读。</p></div>
    <a class="button button--secondary" asp-page="@(Model.Scope == LedgerScope.Internal ? "/Ledger/Internal/Index" : "/Ledger/External/Index")" asp-route-view="@Model.ActiveTab">返回账本</a>
</section>

@* 删除确认弹窗在账本工作台展示，并通过 DeleteReason（删除原因）字段提交可追溯原因。 *@

<dialog class="quick-edit-dialog ledger-entry-dialog" open data-ledger-entry-dialog>
    <form method="post" asp-page-handler="Save" class="quick-edit-form" data-ledger-entry-form>
        <input type="hidden" asp-for="RecordId" />
        <input type="hidden" asp-for="ActiveTab" />
        <div class="quick-edit-heading"><div><span class="eyebrow">统一录入</span><h2>@(Model.IsEditing ? "编辑财务记录" : "新增财务记录")</h2><span>按记录类型切换字段，保存前确认金额和分摊范围。</span></div><a class="dialog-close" aria-label="返回账本" href="@(Model.Scope == LedgerScope.Internal ? "/Ledger/Internal/Index" : "/Ledger/External/Index")?view=@Model.ActiveTab">×</a></div>
        <div asp-validation-summary="All" class="quick-edit-validation validation-summary"></div>
        @if (Model.IsReadOnly)
        {
            <div class="ledger-readonly-banner"><strong>当前记录为只读</strong><span>@Model.ReadOnlyReason</span><small>请返回来源模块，或使用分摊调整、调整和冲销操作留下可追溯记录。</small></div>
        }
        <div class="quick-edit-body ledger-entry-body">
            <section class="ledger-entry-section ledger-entry-context"><h3>记录范围与主体</h3><div class="ledger-entry-grid">
                <label>账本范围<select asp-for="Scope" data-ledger-scope><option value="External">外部账本</option><option value="Internal">内部账本</option></select></label>
                <label>记录类型<select asp-for="RecordType" data-ledger-record-type><option value="Settlement">结算</option><option value="Deduction">扣款</option><option value="Invoice">发票</option><option value="Cash">资金</option></select></label>
                <label>方向<select asp-for="Direction" data-ledger-direction><option value="Receivable">应收/收款/销项</option><option value="Payable">应付/付款/进项</option></select></label>
                <label data-ledger-field="settlement">结算状态<select asp-for="SettlementState"><option value="Final">正式</option><option value="Provisional">暂估</option></select></label>
                <label>自有公司<select asp-for="LegalEntityId" required><option value="">请选择</option>@foreach (var item in Model.Options.LegalEntities) { <option value="@item.Id">@item.Label</option> }</select></label>
                <label data-ledger-field="external">外部合作单位<select asp-for="BusinessPartnerId"><option value="">请选择合作单位</option>@foreach (var item in Model.Options.BusinessPartners) { <option value="@item.Id">@item.Label</option> }</select></label>
                <label data-ledger-field="internal">对方自有公司<select asp-for="CounterLegalEntityId"><option value="">请选择另一家自有公司</option>@foreach (var item in Model.Options.CounterLegalEntities) { <option value="@item.Id">@item.Label</option> }</select></label>
                <label data-ledger-field="project">项目<select asp-for="ProjectId"><option value="">可不选</option>@foreach (var item in Model.Options.Projects) { <option value="@item.Id">@item.Label</option> }</select></label>
                <label data-ledger-field="project">合同<select asp-for="ContractId"><option value="">可不选</option>@foreach (var item in Model.Options.Contracts) { <option value="@item.Id">@item.Label</option> }</select></label>
                <label>业务日期<input asp-for="BusinessDate" type="date" required /></label>
            </div></section>

            <section class="ledger-entry-section ledger-entry-money"><h3>金额</h3><div class="ledger-entry-grid"><label>金额<input asp-for="Amount" type="number" step="0.01" min="0.01" required data-ledger-amount /></label><label data-ledger-field="settlement">应开票金额<input asp-for="InvoiceAmount" type="number" step="0.01" min="0" data-ledger-invoice-amount /></label></div></section>

            <section class="ledger-entry-section" data-ledger-field="deduction"><h3>扣款关联</h3><div class="ledger-entry-grid"><label>关联结算 ID<input asp-for="SettlementId" placeholder="必须选择已有结算" /></label><label>结算并发版本<input asp-for="SettlementConcurrencyStamp" placeholder="从详情复制当前版本" /></label><label class="checkbox-field"><input asp-for="ReduceInvoiceAmount" /> 同时扣减应开票金额</label><label class="ledger-entry-wide">扣款原因<input asp-for="Reason" placeholder="必填，说明扣款依据" /></label></div></section>

            <section class="ledger-entry-section" data-ledger-field="invoice"><h3>发票资料</h3><div class="ledger-entry-grid"><label>发票号码<input asp-for="InvoiceNumber" required /></label><label>发票类型<input asp-for="InvoiceType" /></label><label>未税金额<input asp-for="NetAmount" type="number" step="0.01" min="0" /></label><label>税额<input asp-for="TaxAmount" type="number" step="0.01" min="0" /></label><label>税率<input asp-for="TaxRate" type="number" step="0.0001" min="0" max="1" /></label></div></section>

            <section class="ledger-entry-section" data-ledger-field="cash"><h3>资金资料</h3><div class="ledger-entry-grid"><label>资金账户<select asp-for="AccountId"><option value="">请选择</option>@foreach (var item in Model.Options.Accounts) { <option value="@item.Id">@item.Label</option> }</select></label><label data-ledger-field="internal">对方资金账户<select asp-for="CounterAccountId"><option value="">内部转账可选</option>@foreach (var item in Model.Options.Accounts) { <option value="@item.Id">@item.Label</option> }</select></label><label>收付款方式<input asp-for="PaymentMethod" placeholder="银行转账、现金等" /></label></div></section>

            <section class="ledger-entry-section ledger-entry-allocation" data-ledger-field="allocation"><h3>分摊预览</h3><p class="ledger-entry-help">可以先保存为待分摊；填写分摊目标后会实时校验合计不超过单据金额。</p><label class="checkbox-field"><input asp-for="AutoAllocate" /> 未填写手工分摊时按 FIFO 自动分摊</label><div class="allocation-row"><label>分摊结算ID<input asp-for="Allocations[0].SettlementId" /></label><label>分摊金额<input asp-for="Allocations[0].Amount" type="number" step="0.01" min="0" data-ledger-allocation-amount /></label></div><div class="ledger-entry-preview"><div><span>单据金额</span><strong data-ledger-preview-total>0.00</strong></div><div><span>本次分摊</span><strong data-ledger-preview-allocated>0.00</strong></div><div><span>剩余待分摊</span><strong class="is-pending" data-ledger-preview-remaining>0.00</strong></div></div></section>

            <section class="ledger-entry-section"><h3>说明与修改原因</h3><div class="ledger-entry-grid"><label class="ledger-entry-wide">业务说明<textarea asp-for="Notes" rows="3" placeholder="可填写结算依据、发票或资金背景"></textarea></label><label class="ledger-entry-wide">@(Model.IsEditing ? "修改原因" : "备注/原因")<textarea asp-for="Reason" rows="3" placeholder="编辑、调整或扣款时必须填写可追溯原因"></textarea></label></div></section>
        </div>
        <div class="quick-edit-actions"><a class="button button--secondary" href="@(Model.Scope == LedgerScope.Internal ? "/Ledger/Internal/Index" : "/Ledger/External/Index")?view=@Model.ActiveTab">取消</a>@if (!Model.IsReadOnly) { <button class="button button--primary" type="submit">@(Model.IsEditing ? "保存修改" : "保存到中央账本")</button> }</div>
    </form>
</dialog>

@section Scripts {
    <script type="module" src="~/js/pages/central-ledger-entry.js" asp-append-version="true"></script>
}
