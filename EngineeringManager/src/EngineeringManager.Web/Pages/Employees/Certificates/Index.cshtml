@page
@model EngineeringManager.Web.Pages.Employees.Certificates.IndexModel
@using EngineeringManager.Domain.Certificates
@using EngineeringManager.Web.Workbenches
@{
    ViewData["Title"] = "员工证书管理";
    var statusOptions = new DataWorkbenchFilterOption[]
    {
        new("Info", "轻度提醒"), new("Warning", "中度提醒"), new("Critical", "高度提醒"),
        new("Expired", "已过期"), new("LongTerm", "长期有效"), new("Normal", "有效")
    };
    var workbench = DataWorkbenchPresets.EmployeeCertificates with
    {
        InlineFilters = new DataWorkbenchFilterField[] { new("Search", "搜索", Model.Search, Placeholder: "搜索证书全部信息") },
        Filters = new DataWorkbenchFilterField[]
        {
            new("EmployeeId", "员工", Model.EmployeeId?.ToString(), DataWorkbenchFilterKind.Select,
                Model.Employees.Select(employee => new DataWorkbenchFilterOption(employee.Id.ToString(), $"{employee.EmployeeNumber} · {employee.Name}")).ToArray()),
            new("CertificateType", "证书类型", Model.CertificateType, DataWorkbenchFilterKind.Select,
                Model.CertificateTypes.Select(type => new DataWorkbenchFilterOption(type, type)).ToArray()),
            new("State", "状态", Model.State?.ToString(), DataWorkbenchFilterKind.Select, statusOptions)
        }
    };
    var scopeName = Model.State.HasValue ? IndexModel.StatusLabel(Model.State.Value) : "全部证书";
    var upcomingCount = Model.StateSummaryCertificates.Count(item => item.State is CertificateExpiryState.Info or CertificateExpiryState.Warning or CertificateExpiryState.Critical);
    var expiredCount = Model.StateSummaryCertificates.Count(item => item.State == CertificateExpiryState.Expired);
    var longTermCount = Model.StateSummaryCertificates.Count(item => item.State == CertificateExpiryState.LongTerm);
}

<partial name="../_EmployeeSubNavigation.cshtml" />

<div class="employee-workspace-page" data-employee-workspace>
    <section class="page-heading compact-page-heading employee-workspace-heading">
        <div><p class="eyebrow">人员证照台账</p><h1>证书总览</h1><p class="page-lead">员工可没有证书，也可维护多本证书。系统按自然月在到期前三个月、两个月和一个月分级提醒。</p></div>
        <div class="page-actions-inline">@if (Model.CanManage) { <a class="button button--primary button--action" asp-page="Edit">新增员工证书</a> }</div>
    </section>

    <section class="employee-workspace-layout">
        <aside class="employee-workspace-summary">
            <div class="equipment-summary-heading"><span>证书概览</span><strong>@scopeName</strong></div>
            <div class="overview-strip employee-summary-metrics" aria-label="员工证书统计">
                <article class="employee-summary-metric--total"><span>证书总数</span><strong>@Model.StateSummaryCertificates.Count</strong></article>
                <article class="employee-summary-metric--active"><span>三个月内到期</span><strong>@upcomingCount</strong></article>
                <article class="employee-summary-metric--payable"><span>已过期</span><strong>@expiredCount</strong></article>
                <article class="employee-summary-metric--unpaid"><span>长期有效</span><strong>@longTermCount</strong></article>
            </div>
            <section class="employee-type-summary" aria-label="证书状态筛选">
                <div class="equipment-company-summary-heading"><div><span>到期状态</span><strong>按状态筛选</strong></div><small>6 类</small></div>
                <div class="employee-type-summary-list">
                    <a class="employee-type-summary-row @(!Model.State.HasValue ? "is-active" : null)" asp-page="Index" asp-route-search="@Model.Search" asp-route-employeeId="@Model.EmployeeId" asp-route-certificateType="@Model.CertificateType"><span>全部证书</span><strong>@Model.StateSummaryCertificates.Count</strong></a>
                    <a class="employee-type-summary-row @(Model.State == CertificateExpiryState.Info ? "is-active" : null)" asp-page="Index" asp-route-search="@Model.Search" asp-route-employeeId="@Model.EmployeeId" asp-route-certificateType="@Model.CertificateType" asp-route-state="Info"><span>轻度提醒</span><strong>@Model.StateSummaryCertificates.Count(item => item.State == CertificateExpiryState.Info)</strong></a>
                    <a class="employee-type-summary-row @(Model.State == CertificateExpiryState.Warning ? "is-active" : null)" asp-page="Index" asp-route-search="@Model.Search" asp-route-employeeId="@Model.EmployeeId" asp-route-certificateType="@Model.CertificateType" asp-route-state="Warning"><span>中度提醒</span><strong>@Model.StateSummaryCertificates.Count(item => item.State == CertificateExpiryState.Warning)</strong></a>
                    <a class="employee-type-summary-row @(Model.State == CertificateExpiryState.Critical ? "is-active" : null)" asp-page="Index" asp-route-search="@Model.Search" asp-route-employeeId="@Model.EmployeeId" asp-route-certificateType="@Model.CertificateType" asp-route-state="Critical"><span>高度提醒</span><strong>@Model.StateSummaryCertificates.Count(item => item.State == CertificateExpiryState.Critical)</strong></a>
                    <a class="employee-type-summary-row @(Model.State == CertificateExpiryState.Expired ? "is-active" : null)" asp-page="Index" asp-route-search="@Model.Search" asp-route-employeeId="@Model.EmployeeId" asp-route-certificateType="@Model.CertificateType" asp-route-state="Expired"><span>已过期</span><strong>@expiredCount</strong></a>
                    <a class="employee-type-summary-row @(Model.State == CertificateExpiryState.LongTerm ? "is-active" : null)" asp-page="Index" asp-route-search="@Model.Search" asp-route-employeeId="@Model.EmployeeId" asp-route-certificateType="@Model.CertificateType" asp-route-state="LongTerm"><span>长期有效</span><strong>@longTermCount</strong></a>
                </div>
            </section>
        </aside>

        <section class="employee-workspace-list">
            <div class="equipment-list-toolbar equipment-list-toolbar--integrated employee-list-toolbar"><div><p class="eyebrow">证书清单</p><h2>@scopeName</h2></div><partial name="_DataWorkbench" model="workbench" /></div>
            @if (Model.Certificates.Count == 0) { <p class="panel-copy">当前筛选范围内没有员工证书。</p> }
            else { <div class="table-wrap employee-table-wrap"><table class="data-table employee-workspace-table employee-certificate-table" id="employee-certificates-table"><thead><tr><th data-column-key="employee">员工</th><th data-column-key="certificate_type">证书类型</th><th data-column-key="certificate_number">证书编号</th><th data-column-key="scope">专业/等级/范围</th><th data-column-key="authority">发证机关</th><th data-column-key="issued_on">签发日期</th><th data-column-key="expires_on">到期日期</th><th data-column-key="status">状态</th><th data-column-key="attachment">附件</th><th data-column-key="actions">操作</th></tr></thead><tbody>
                @foreach (var item in Model.Certificates) { <tr><td data-column-key="employee"><strong>@item.EmployeeName</strong><span class="table-secondary">@item.EmployeeNumber</span></td><td data-column-key="certificate_type">@item.CertificateType</td><td data-column-key="certificate_number">@(item.CertificateNumber ?? "—")</td><td data-column-key="scope">@(item.SpecialtyLevelScope ?? "—")</td><td data-column-key="authority">@(item.IssuingAuthority ?? "—")</td><td data-column-key="issued_on">@(item.IssuedOn?.ToString("yyyy-MM-dd") ?? "—")</td><td data-column-key="expires_on">@(item.ExpiresOn?.ToString("yyyy-MM-dd") ?? "长期有效")</td><td data-column-key="status"><span class="certificate-status certificate-status--@IndexModel.StatusClass(item.State)">@IndexModel.StatusLabel(item.State)</span></td><td data-column-key="attachment">@if (item.AttachmentId.HasValue) { <a asp-page-handler="Attachment" asp-route-id="@item.Id">@item.AttachmentFileName</a> } else { <span>—</span> }</td><td data-column-key="actions"><div class="employee-row-actions">@if (Model.CanManage) { <a class="action-button action-button--edit" asp-page="Edit" asp-route-id="@item.Id">编辑</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('确认删除这本员工证书？');"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="concurrencyStamp" value="@item.ConcurrencyStamp" /><button class="action-button action-button--delete" type="submit">删除</button></form> }</div></td></tr> }
            </tbody></table></div> }
        </section>
    </section>
</div>
