@page
@model EngineeringManager.Web.Pages.Companies.IndexModel
@using EngineeringManager.Web.Workbenches
@using System.Text.Json
@{
    ViewData["Title"] = "自有公司";
    var dashboard = Model.Dashboard;
    var uncollected = dashboard.ReceivableAmount - dashboard.CollectedAmount;
    var collectionRate = dashboard.ReceivableAmount <= 0m
        ? 0d
        : (double)Math.Clamp(dashboard.CollectedAmount / dashboard.ReceivableAmount * 100m, 0m, 100m);
    var paymentRate = dashboard.PayableAmount <= 0m
        ? 0d
        : (double)Math.Clamp(dashboard.PaidAmount / dashboard.PayableAmount * 100m, 0m, 100m);
    var invoiceRate = dashboard.OutputInvoiceAmount <= 0m
        ? 0d
        : (double)Math.Clamp(dashboard.InputInvoiceAmount / dashboard.OutputInvoiceAmount * 100m, 0m, 100m);
    var costTotal = dashboard.PayrollCost + dashboard.EquipmentCost;
    var payrollShare = costTotal <= 0m
        ? 0d
        : (double)Math.Clamp(dashboard.PayrollCost / costTotal * 100m, 0m, 100m);
    var workbench = DataWorkbenchPresets.Companies with
    {
        RowDensity = EngineeringManager.Application.Settings.TableDensity.Compact,
        InlineFilters = new DataWorkbenchFilterField[]
        {
            new("CompanyId", "范围", Model.CompanyId?.ToString(), DataWorkbenchFilterKind.Select,
                Model.Companies.Select(company => new DataWorkbenchFilterOption(company.Id.ToString(), company.Name)).ToArray()),
            new("Search", "搜索", Model.Search, Placeholder: "搜索公司全部信息")
        }
    };
    string AttachmentContentType(string? fileName) => System.IO.Path.GetExtension(fileName)?.ToLowerInvariant() switch
    {
        ".pdf" => "application/pdf", ".jpg" or ".jpeg" => "image/jpeg", ".png" => "image/png", _ => "application/octet-stream"
    };
}

<div class="company-workspace company-workspace--overview" data-company-dashboard>
    <section class="page-heading company-workspace-heading">
        <div>
            <p class="eyebrow">公司维度经营统计</p>
            <h1>自有公司</h1>
            <p class="page-lead">在同一工作台查看各公司经营汇总、档案与业务入口。</p>
        </div>
        <div class="button-row company-workspace-actions">
            <partial name="_CompanyScopeSwitcher" model="(Model.Companies, (Guid?)null, (string?)null)" />
            @if (Model.CanManage)
            {
                <a class="button button--primary button--action" asp-page="Edit">新增公司</a>
            }
        </div>
    </section>

    <section class="metric-grid company-metric-grid" aria-label="公司关键指标">
        <article class="metric-card company-metric-card">
            <span class="metric-label">公司数量</span>
            <strong class="metric-value">@dashboard.CompanyCount</strong>
            <span class="metric-hint">权限范围内可见公司</span>
        </article>
        <article class="metric-card company-metric-card" data-company-employee-count="@Model.EmployeeCount">
            <span class="metric-label">员工数量</span>
            <strong class="metric-value">@Model.EmployeeCount</strong>
            <span class="metric-hint">当前在职员工</span>
        </article>
        <article class="metric-card company-metric-card company-metric-card--accent">
            <span class="metric-label">未收款</span>
            <strong class="metric-value">@uncollected.ToString("N2")</strong>
            <span class="metric-hint">已收 @dashboard.CollectedAmount.ToString("N2") / 应收 @dashboard.ReceivableAmount.ToString("N2")</span>
            <div class="company-mini-progress" aria-hidden="true">
                <span class="progress-track"><span class="progress-fill" style="width:@collectionRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                <small>回款进度 @collectionRate.ToString("0.#")%</small>
            </div>
        </article>
    </section>

    <section class="dashboard-grid company-dashboard-grid company-portfolio-grid">
        <div class="company-dashboard-stack@(Model.CanManage ? null : " company-dashboard-stack--single")">
        <article class="panel company-panel company-money-panel" data-company-money-chart data-chart data-chart-kind="progress-ring" data-chart-value="@collectionRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-chart-label="公司收款完成率">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">金额对比</p>
                    <h2>收款、付款与开票</h2>
                </div>
                <div class="company-chart-ring"><span>收款完成率</span><div data-chart-canvas></div></div>
            </div>
            <div class="comparison-chart company-comparison-chart">
                <div class="comparison-row">
                    <div class="chart-label"><strong>应收 / 已收</strong><span>@dashboard.ReceivableAmount.ToString("N2") / @dashboard.CollectedAmount.ToString("N2")</span></div>
                    <div class="progress-track"><span class="progress-fill" style="width:@collectionRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                </div>
                <div class="comparison-row">
                    <div class="chart-label"><strong>应付 / 已付</strong><span>@dashboard.PayableAmount.ToString("N2") / @dashboard.PaidAmount.ToString("N2")</span></div>
                    <div class="progress-track"><span class="progress-fill progress-fill--stage" style="width:@paymentRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                </div>
                <div class="comparison-row">
                    <div class="chart-label"><strong>销项 / 进项发票</strong><span>@dashboard.OutputInvoiceAmount.ToString("N2") / @dashboard.InputInvoiceAmount.ToString("N2")</span></div>
                    <div class="progress-track"><span class="progress-fill" style="width:@invoiceRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                </div>
                <div class="comparison-row">
                    <div class="chart-label"><strong>工资 / 设备成本</strong><span>@dashboard.PayrollCost.ToString("N2") / @dashboard.EquipmentCost.ToString("N2")</span></div>
                    <div class="progress-track"><span class="progress-fill progress-fill--stage" style="width:@payrollShare.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                </div>
            </div>
        </article>
        @if (Model.CanManage)
        {
            <article class="panel company-panel company-category-panel inline-edit-shell" data-inline-edit="company-categories" data-inline-cell-edit data-inline-edit-active="@(Model.CategoryEditOpen ? "true" : "false")">
                <div class="panel-heading"><div><p class="eyebrow">主数据</p><h2>组合分类维护</h2></div></div>
                <div asp-validation-summary="All" class="panel-copy"></div>
                <form id="category-create-form" method="post" asp-page-handler="Category" class="company-category-form">
                    <div class="company-category-create-grid">
                        <label>分类编码<input asp-for="Category.Code" required /></label>
                        <label>分类名称<input asp-for="Category.Name" required /></label>
                        <label>排序<input asp-for="Category.SortOrder" type="number" /></label>
                    </div>
                </form>
                <div class="company-category-action-row">
                    <button class="button button--secondary" type="button" data-inline-edit-open data-inline-edit-value>编辑修改</button>
                    <button class="button button--primary" type="submit" form="category-create-form" data-inline-edit-value>保存分类</button>
                    <button class="button button--secondary" type="button" data-inline-edit-cancel data-inline-edit-actions hidden>取消修改</button>
                    <form id="category-batch-form" method="post" asp-page-handler="Categories" class="inline-form" data-inline-edit-actions hidden>
                        <button class="button button--primary" type="submit">保存修改</button>
                    </form>
                </div>
                @if (Model.Categories.Count > 0)
                {
                    <div class="table-wrap company-table-wrap company-category-table-wrap">
                        <table class="data-table row-spacing-compact">
                            <thead><tr><th>编码</th><th>分类名称</th><th>排序</th><th>状态</th></tr></thead>
                            <tbody>
                            @for (var categoryIndex = 0; categoryIndex < Model.CategoryRows.Count; categoryIndex++)
                            {
                                var category = Model.CategoryRows[categoryIndex];
                                <tr>
                                    <td>
                                        <input type="hidden" name="CategoryRows[@categoryIndex].Id" value="@category.Id" form="category-batch-form" />
                                        <input type="hidden" name="CategoryRows[@categoryIndex].ConcurrencyStamp" value="@category.ConcurrencyStamp" form="category-batch-form" />
                                        <span data-inline-edit-value>@category.Code</span>
                                        <input class="inline-cell-control" name="CategoryRows[@categoryIndex].Code" value="@category.Code" form="category-batch-form" data-inline-edit-control hidden required />
                                    </td>
                                    <td>
                                        <span data-inline-edit-value>@category.Name</span>
                                        <input class="inline-cell-control" name="CategoryRows[@categoryIndex].Name" value="@category.Name" form="category-batch-form" data-inline-edit-control hidden required />
                                    </td>
                                    <td>
                                        <span data-inline-edit-value>@category.SortOrder</span>
                                        <input class="inline-cell-control" name="CategoryRows[@categoryIndex].SortOrder" value="@category.SortOrder" type="number" form="category-batch-form" data-inline-edit-control hidden />
                                    </td>
                                    <td>
                                        <span class="pill @(category.IsActive ? "pill--success" : "pill--warning")" data-inline-edit-value>@(category.IsActive ? "启用" : "停用")</span>
                                        <div class="company-category-status-edit">
                                            <select class="inline-cell-control" name="CategoryRows[@categoryIndex].IsActive" form="category-batch-form" data-inline-edit-control hidden>
                                                <option value="true" selected="@(category.IsActive ? "selected" : null)">启用</option>
                                                <option value="false" selected="@(!category.IsActive ? "selected" : null)">停用</option>
                                            </select>
                                            <form method="post" asp-page-handler="DeleteCategory" class="inline-form" data-inline-edit-control hidden>
                                                <input type="hidden" name="categoryId" value="@category.Id" />
                                                <input type="hidden" name="concurrencyStamp" value="@category.ConcurrencyStamp" />
                                                <button class="button button--ghost button--small" type="submit" onclick="return confirm('确认删除该分类？已被公司使用的分类不能删除。')">删除</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </article>
        }
        </div>
        <article class="panel company-panel company-list-panel">
            <div class="equipment-list-toolbar equipment-list-toolbar--integrated company-list-toolbar">
                <div><p class="eyebrow">公司档案</p><h2>公司列表</h2></div>
                <partial name="_DataWorkbench" model="workbench" />
            </div>
            @if (Model.Companies.Count == 0)
            {
                <p class="panel-copy company-empty-copy">当前权限范围内没有自有公司。</p>
            }
            else
            {
                <div class="table-wrap company-table-wrap">
                    <table class="data-table row-spacing-compact" id="companies-table">
                        <thead>
                            <tr>
                                <th data-column-key="code">编码</th>
                                <th data-column-key="company">公司</th>
                                <th data-column-key="category">分类</th>
                                <th data-column-key="representative">法人/经营者</th>
                                <th data-column-key="accounts">账户</th>
                                <th data-column-key="notes">备注摘要</th>
                                <th data-column-key="status">状态</th>
                                <th data-column-key="actions">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var company in Model.Companies)
                        {
                            <tr>
                                <td data-column-key="code">@company.Code</td>
                                <td data-column-key="company"><a class="company-name-link" asp-page="Details" asp-route-id="@company.Id" asp-route-tab="overview">@company.Name</a></td>
                                <td data-column-key="category">@(company.CategoryName ?? "未分类")</td>
                                <td data-column-key="representative">@(string.IsNullOrWhiteSpace(company.LegalRepresentative) ? "—" : company.LegalRepresentative)</td>
                                <td data-column-key="accounts">
                                    <a asp-page="Details" asp-route-id="@company.Id" asp-route-tab="accounts">
                                        @company.ActiveAccountCount 个启用
                                        @if (company.TotalAccountCount > company.ActiveAccountCount)
                                        {
                                            <span class="company-muted">（共 @company.TotalAccountCount 个）</span>
                                        }
                                    </a>
                                </td>
                                <td data-column-key="notes">@(string.IsNullOrWhiteSpace(company.Notes) ? "—" : company.Notes)</td>
                                <td data-column-key="status">
                                    <span class="pill @(company.IsActive ? "pill--success" : "pill--warning")">@(company.IsActive ? "启用" : "停用")</span>
                                </td>
                                <td data-column-key="actions">
                                    <div class="company-row-actions">
                                        @{ var details = Model.CompanyDetails[company.Id]; var payload = JsonSerializer.Serialize(new { details.Id, details.Code, details.Name, details.ShortName, details.CompanyCategoryId, details.CompanyCategoryName, details.LegalRepresentative, details.UnifiedSocialCreditCode, details.RegisteredAddress, details.BusinessAddress, details.Phone, details.InvoiceTitle, details.Notes, details.IsActive, details.ConcurrencyStamp }); }
                                        <button class="action-button action-button--view" type="button" data-company-view-open data-company-payload="@payload">查看</button>
                                        @if (Model.CanManage)
                                        {
                                            <button class="action-button action-button--edit" type="button" data-company-edit-open data-company-payload="@payload">编辑</button>
                                            <button class="action-button action-button--copy" type="button" data-company-copy-open data-company-payload="@payload">复制</button>
                                        }
                                        <button class="action-button action-button--certificate" type="button" data-company-certificates-open data-company-id="@company.Id">证书</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
</div>

<dialog class="workbench-dialog company-dialog mac-window-dialog" data-company-workspace-dialog data-dialog-open="@Model.CompanyDialogOpen.ToString().ToLowerInvariant()" aria-labelledby="company-dialog-title">
    <form method="post" asp-page-handler="Company">
        <div class="workbench-dialog-heading"><span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span><div><strong id="company-dialog-title" data-company-dialog-title>编辑公司</strong><span>公司资料修改将保留审计记录。</span></div><button class="dialog-close" type="button" data-company-dialog-close aria-label="关闭">×</button></div>
        <div class="company-create-dialog-body company-dialog-body company-dialog-form-grid form-grid">
            <div asp-validation-summary="All" class="form-span validation-summary"></div>
            <section class="form-section">
                <h2 class="section-heading">主体资料</h2>
                <label>公司编码<input asp-for="CompanyInput.Code" required /></label>
                <label>公司全称<input asp-for="CompanyInput.Name" required /></label>
                <label>公司简称<input asp-for="CompanyInput.ShortName" required /></label>
                <label>组合分类<select asp-for="CompanyInput.CompanyCategoryId" required><option value="">请选择</option>@foreach (var category in Model.Categories.Where(x => x.IsActive)) { <option value="@category.Id">@category.Name</option> }</select></label>
                <label>状态<select asp-for="CompanyInput.IsActive"><option value="true">启用</option><option value="false">停用</option></select></label>
                <label>法人/经营者<input asp-for="CompanyInput.LegalRepresentative" /></label>
                <label>统一社会信用代码/税号<input asp-for="CompanyInput.UnifiedSocialCreditCode" /></label>
            </section>
            <section class="form-section"><h2 class="section-heading">地址与开票</h2><label>注册地址<input asp-for="CompanyInput.RegisteredAddress" /></label><label>经营地址<input asp-for="CompanyInput.BusinessAddress" /></label><label>电话<input asp-for="CompanyInput.Phone" /></label><label>开票抬头<input asp-for="CompanyInput.InvoiceTitle" /></label><label class="form-span">备注<textarea asp-for="CompanyInput.Notes"></textarea></label></section>
            <label class="form-span">修改原因<input asp-for="CompanyInput.Reason" required /></label>
            <input asp-for="CompanyInput.Id" type="hidden" /><input asp-for="CompanyInput.ConcurrencyStamp" type="hidden" />
        </div>
        <div class="workbench-dialog-actions"><button class="button button--secondary" type="button" data-company-dialog-close>取消</button><button class="button button--primary" type="submit">保存</button></div>
    </form>
</dialog>

<dialog class="workbench-dialog company-dialog company-dialog--content mac-window-dialog" data-company-view-dialog aria-labelledby="company-view-title"><div class="workbench-dialog-heading"><span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span><strong id="company-view-title">查看公司</strong><button class="dialog-close" type="button" data-company-view-close aria-label="关闭公司查看窗口">×</button></div><div class="company-dialog-body company-view-dialog-body detail-grid entity-details-body"><div class="entity-detail-sections" data-company-view-content></div></div><div class="workbench-dialog-actions"><button class="button button--secondary" type="button" data-company-view-close>关闭</button></div></dialog>

@foreach (var company in Model.Companies)
{
    <dialog class="workbench-dialog company-dialog company-dialog--content mac-window-dialog" data-company-certificates-dialog="@company.Id" aria-labelledby="company-certificates-title-@company.Id">
        <div class="workbench-dialog-heading"><span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span><div><strong id="company-certificates-title-@company.Id">@company.Name · 证书</strong><span>点击附件可预览或下载。</span></div><button class="dialog-close" type="button" data-company-certificates-close aria-label="关闭公司证书窗口">×</button></div>
        <div class="company-dialog-body company-certificate-dialog-body table-wrap"><table class="data-table"><thead><tr><th>类型</th><th>编号</th><th>到期日期</th><th>附件</th></tr></thead><tbody>
        @foreach (var certificate in Model.CompanyCertificates.Where(item => item.LegalEntityId == company.Id))
        {
            <tr><td>@certificate.CertificateType</td><td>@(certificate.CertificateNumber ?? "—")</td><td>@(certificate.ExpiresOn?.ToString("yyyy-MM-dd") ?? "长期有效")</td><td>@if (certificate.AttachmentId.HasValue) { <a data-attachment-preview-trigger asp-page="/Companies/Certificates/Index" asp-page-handler="Attachment" asp-route-id="@certificate.Id" data-attachment-name="@certificate.AttachmentFileName" data-attachment-content-type="@AttachmentContentType(certificate.AttachmentFileName)">@certificate.AttachmentFileName</a> } else { <span>—</span> }</td></tr>
        }
        </tbody></table></div>
        <div class="workbench-dialog-actions">@if (Model.CanManage) { <a class="button button--secondary" asp-page="/Companies/Certificates/Index" asp-route-CompanyId="@company.Id">维护证书</a> }<button class="button button--secondary" type="button" data-company-certificates-close>关闭</button></div>
    </dialog>
}

<dialog class="attachment-preview-dialog mac-window-dialog" data-attachment-preview-dialog aria-labelledby="company-attachment-title"><div class="workbench-dialog-heading"><span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span><strong id="company-attachment-title" data-attachment-preview-title>附件预览</strong><button class="dialog-close" type="button" data-attachment-preview-close aria-label="关闭附件预览窗口">×</button></div><div class="attachment-preview-body"><img data-attachment-preview-image alt="证书附件预览" hidden /><iframe data-attachment-preview-frame title="证书附件预览" hidden></iframe><p data-attachment-preview-fallback hidden></p></div><div class="workbench-dialog-actions"><a class="button button--primary" data-attachment-preview-download>下载</a><button class="button button--secondary" type="button" data-attachment-preview-close>关闭</button></div></dialog>

@section Scripts { <script type="module" src="~/js/pages/company-workspace.js" asp-append-version="true"></script> }
