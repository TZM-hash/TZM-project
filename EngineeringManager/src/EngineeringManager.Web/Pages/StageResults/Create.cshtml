@page
@model EngineeringManager.Web.Pages.StageResults.CreateModel
@using EngineeringManager.Domain.StageResults
@{
    ViewData["Title"] = "提交阶段成果";
}

<section class="page-heading"><div><p class="eyebrow">阶段成果</p><h1>提交阶段成果</h1><p class="page-lead">本入口支持先保存草稿；工程量明细和照片文件会继续接入同一阶段成果服务。</p></div></section>
<form method="post" class="panel form-grid">
    <section class="form-section"><h2 class="section-heading">成果归属</h2><label>项目 ID<input asp-for="ProjectId" /></label><label>合同 ID（可选）<input asp-for="ContractId" /></label><label>阶段名称<input asp-for="Title" /></label><label>成果日期<input asp-for="ResultDate" type="date" /></label></section>
    <section class="form-section"><h2 class="section-heading">成果状态</h2><label>成果类型<select asp-for="ResultType"><option value="1">进度</option><option value="2">验收</option><option value="3">完工</option><option value="4">结算支撑</option></select></label><label>状态<select asp-for="Status"><option value="1">草稿</option><option value="2">已记录</option><option value="3">已作废</option></select></label><label>质量情况<select asp-for="QualityResult"><option value="1">未检查</option><option value="2">合格</option><option value="3">有条件合格</option><option value="4">不合格</option></select></label><label class="form-span">说明<textarea asp-for="Description" rows="4"></textarea></label></section>
    <div class="sticky-actions form-span"><button class="button button--secondary" type="submit">保存阶段成果</button></div>
</form>
