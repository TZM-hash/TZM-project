@page
@using EngineeringManager.Domain.Employees
@using EngineeringManager.Domain.Finance
@using EngineeringManager.Web.Presentation
@model EngineeringManager.Web.Pages.Ledger.External.IndexModel
@{
    ViewData["Title"] = "中央账本 · 外部账本";
    var receivable = Model.Result.ReceivableTotals ?? CentralLedgerMetrics.Zero;
    var payable = Model.Result.PayableTotals ?? CentralLedgerMetrics.Zero;
    var detailsUrl = Url.Page("/Ledger/External/Index", "Details") ?? "/Ledger/External/Index?handler=Details";
    var currentRows = Model.Result.Rows;
    var pendingTotal = (Model.Result.UnallocatedCash ?? []).Sum(item => item.UnallocatedAmount)
        + (Model.Result.Invoices ?? []).Where(item => item.UnallocatedAmount > 0m).Sum(item => item.UnallocatedAmount);
}

<div class="ledger-workspace-page" data-ledger-workspace data-ledger-scope="External" data-ledger-active-tab="@Model.ActiveTab">
    <section class="page-heading compact-page-heading ledger-workspace-heading">
        <div>
            <p class="eyebrow">中央账本 · 外部范围</p>
            <h1>外部账本</h1>
            <p class="page-lead">统一查看项目、施工班组、合作商和中央录入形成的同一套外部财务记录。</p>
        </div>
        <div class="page-actions-inline">
            <a class="button button--secondary" asp-page="/Admin/FinanceYears/Index">财务年度设置</a>
            @if (Model.CanManage)
            {
                <a class="button button--primary" asp-page="/Ledger/Entries/Edit" asp-route-scope="External" asp-route-view="@Model.ActiveTab" data-ledger-entry-open>新增财务记录</a>
            }
        </div>
    </section>

    <section class="ledger-workspace-layout">
        <aside class="ledger-workspace-summary" aria-label="外部账本汇总">
            <div class="ledger-summary-heading"><span class="eyebrow">范围汇总</span><strong>本次筛选结果</strong></div>
            <div class="ledger-summary-metrics">
                <a class="ledger-summary-metric ledger-summary-metric--receivable" href="@Model.TabUrl("receivable")"><span>应收未收</span><strong>@receivable.UncollectedOrUnpaid.ToString("N2")</strong><small>应收 @receivable.ActualAmount.ToString("N2")</small></a>
                <a class="ledger-summary-metric ledger-summary-metric--payable" href="@Model.TabUrl("payable")"><span>应付未付</span><strong>@payable.UncollectedOrUnpaid.ToString("N2")</strong><small>应付 @payable.ActualAmount.ToString("N2")</small></a>
                <a class="ledger-summary-metric ledger-summary-metric--paid" href="@Model.TabUrl("collection")"><span>已收款</span><strong>@receivable.CashAmount.ToString("N2")</strong><small>点击查看收款</small></a>
                <a class="ledger-summary-metric ledger-summary-metric--paid" href="@Model.TabUrl("payment")"><span>已付款</span><strong>@payable.CashAmount.ToString("N2")</strong><small>点击查看付款</small></a>
                <a class="ledger-summary-metric ledger-summary-metric--pending" href="@Model.TabUrl("pending")"><span>待分摊</span><strong>@pendingTotal.ToString("N2")</strong><small>资金与发票</small></a>
                <a class="ledger-summary-metric ledger-summary-metric--danger" href="@Model.TabUrl("exceptions")"><span>异常记录</span><strong>@currentRows.Count(item => item.Metrics.AdvanceInvoiceCash > 0m || item.Metrics.OverSettlementCash > 0m || item.Metrics.OverInvoiced > 0m)</strong><small>点击查看异常</small></a>
            </div>
            <div class="ledger-summary-shortcuts">
                <div class="ledger-summary-heading"><span class="eyebrow">快捷入口</span><strong>业务区</strong></div>
                <a class="ledger-summary-link @(Model.ActiveTab == "sales-invoice" ? "is-active" : null)" href="@Model.TabUrl("sales-invoice")"><span>销项发票</span><strong>@((Model.Result.Invoices ?? []).Count(item => item.Direction == LedgerDirection.Receivable))</strong></a>
                <a class="ledger-summary-link @(Model.ActiveTab == "purchase-invoice" ? "is-active" : null)" href="@Model.TabUrl("purchase-invoice")"><span>进项发票</span><strong>@((Model.Result.Invoices ?? []).Count(item => item.Direction == LedgerDirection.Payable))</strong></a>
                <a class="ledger-summary-link @(Model.ActiveTab == "deduction" ? "is-active" : null)" href="@Model.TabUrl("deduction")"><span>扣款记录</span><strong>@((Model.Result.Deductions ?? []).Count)</strong></a>
                <a class="ledger-summary-link @(Model.ActiveTab == "payroll" ? "is-active" : null)" href="@Model.TabUrl("payroll")"><span>工资付款</span><strong>@((Model.Result.PayrollPayments ?? []).Count)</strong></a>
            </div>
        </aside>

        <main class="ledger-workspace-list">
            <div class="ledger-list-toolbar">
                <nav class="ledger-tabs ledger-tabs--workspace" aria-label="外部账本业务标签：应收款、应付款、收款、付款、销项发票、进项发票、扣款、待分摊、异常、年度账、对账、修改日志">
                    @foreach (var tab in Model.Tabs)
                    {
                        <a class="@(Model.ActiveTab == tab.Key ? "is-active" : null)" href="@Model.TabUrl(tab.Key)" aria-current="@(Model.ActiveTab == tab.Key ? "page" : null)">@tab.Label</a>
                    }
                </nav>
                <div class="data-workbench-toolbar ledger-inline-toolbar">
                    <form method="get" class="workbench-inline-filters">
                        <input type="hidden" name="view" value="@Model.ActiveTab" />
                        <input type="hidden" name="sortKey" value="@Model.SortKey" />
                        <input type="hidden" name="sortDescending" value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                        <label class="workbench-inline-filter workbench-inline-filter--select"><span>年度</span><select name="FinanceBusinessYearId"><option value="">全部</option>@foreach (var year in Model.Years) { <option value="@year.Id" selected="@(Model.FinanceBusinessYearId == year.Id)">@year.Name</option> }</select></label>
                        <label class="workbench-inline-filter workbench-inline-filter--text"><span>关键词</span><input name="Search" value="@Model.Search" placeholder="公司、项目、合作单位、发票号或说明" /></label>
                        <button class="button button--primary workbench-inline-submit" type="submit">筛选</button>
                        <a class="button button--secondary workbench-inline-clear" href="@Model.TabUrl(Model.ActiveTab)">重置</a>
                    </form>
                    <div class="workbench-toolbar-actions">
                        <span class="workbench-count">@Model.Result.TotalCount</span><span class="result-count">条结算记录</span>
                        <a class="button button--secondary workbench-tool-button" href="@Model.TabUrl("audit")">查看修改记录</a>
                    </div>
                </div>
            </div>

            @if (Model.ActiveTab is "overview" or "receivable" or "payable" or "exceptions")
            {
                <section class="panel ledger-tab-panel" data-ledger-panel="settlement">
                    <div class="panel-heading"><div><p class="eyebrow">@Model.Tabs.First(item => item.Key == Model.ActiveTab).Label</p><h2>结算明细</h2><p>金额口径来自中央账本计算器，来源记录在此只读。</p></div><span class="result-count">共 @Model.Result.TotalCount 条</span></div>
                    <div class="table-wrap ledger-table-wrap"><table class="data-table ledger-workspace-table" data-list-sort-server="true" data-list-pagination-server="true" data-list-pagination-current-page="@Model.Result.Page" data-list-pagination-total-pages="@Model.Result.TotalPages" data-list-pagination-total-count="@Model.Result.TotalCount" data-list-pagination-page-size="@Model.Result.PageSize" data-list-sort-default-key="BusinessDate" data-list-sort-default-descending="true" data-list-sort-current-key="@Model.SortKey" data-list-sort-current-descending="@Model.SortDescending.ToString().ToLowerInvariant()">
                        <thead><tr><th data-column-key="date" data-sort-key="BusinessDate">日期</th><th data-column-key="direction">方向</th><th data-column-key="company">自有公司</th><th data-column-key="partner" data-sort-key="BusinessPartnerName">合作单位</th><th data-column-key="project" data-sort-key="ProjectName">项目</th><th data-column-key="status">状态</th><th data-column-key="actual" data-sort-key="ActualAmount">实际应收/应付</th><th data-column-key="cash">已收/已付</th><th data-column-key="balance" data-sort-key="UncollectedOrUnpaid">未收/未付</th><th data-column-key="invoice" data-sort-key="ShouldInvoiceAmount">应开票/已开票</th><th data-column-key="risk" data-sort-key="Uninvoiced">异常</th><th data-column-key="actions">操作</th></tr></thead>
                        <tbody>
                        @foreach (var row in currentRows)
                        {
                            var hasIssue = row.Metrics.AdvanceInvoiceCash > 0m || row.Metrics.OverSettlementCash > 0m || row.Metrics.OverInvoiced > 0m;
                            if (Model.ActiveTab == "exceptions" && !hasIssue) { continue; }
                            var amountClass = row.Direction == LedgerDirection.Receivable ? "ledger-amount--receivable" : "ledger-amount--payable";
                            var canEdit = Model.CanManage && row.SourceType == LedgerSourceType.CentralLedger && row.Metrics.InvoicedAmount == 0m && row.Metrics.CashAmount == 0m;
                            <tr>
                                <td><strong>@ProjectDisplayText.DateLabel(row.BusinessDate)</strong><span class="table-secondary">@(row.SettlementState == LedgerSettlementState.Provisional ? "暂估" : "正式")</span></td>
                                <td><span class="ledger-direction ledger-direction--@(row.Direction == LedgerDirection.Receivable ? "receivable" : "payable")">@(row.Direction == LedgerDirection.Receivable ? "应收" : "应付")</span></td>
                                <td>@row.LegalEntityName</td>
                                <td>@(row.BusinessPartnerName ?? "未指定合作单位")</td>
                                <td>@(row.ProjectName ?? "未指定项目")</td>
                                <td><span class="ledger-source-pill @(row.SourceType == LedgerSourceType.CentralLedger ? "is-direct" : "is-source")">@(row.SourceType == LedgerSourceType.CentralLedger ? "中央录入" : "来源记录")</span></td>
                                <td class="numeric-cell"><strong class="ledger-amount @amountClass">@row.Metrics.ActualAmount.ToString("N2")</strong></td>
                                <td class="numeric-cell"><strong class="ledger-amount ledger-amount--paid">@row.Metrics.CashAmount.ToString("N2")</strong></td>
                                <td class="numeric-cell"><strong class="ledger-amount ledger-amount--balance @(hasIssue ? "is-danger" : null)">@row.Metrics.UncollectedOrUnpaid.ToString("N2")</strong></td>
                                <td class="numeric-cell"><span class="table-secondary">@row.Metrics.ShouldInvoiceAmount.ToString("N2")</span><strong class="ledger-amount ledger-amount--invoice">@row.Metrics.InvoicedAmount.ToString("N2")</strong></td>
                                <td>@if (hasIssue) { <span class="pill pill--danger">需关注</span> } else { <span class="pill pill--success">正常</span> }</td>
                                <td><div class="table-action-buttons table-action-buttons--compact ledger-row-actions"><button class="action-button action-button--view" type="button" data-ledger-details-open data-ledger-record-type="Settlement" data-ledger-record-id="@row.SettlementId" data-ledger-record-stamp="@row.ConcurrencyStamp" data-ledger-details-url="@detailsUrl">查看</button>@if (canEdit) { <a class="action-button action-button--edit" asp-page="/Ledger/Entries/Edit" asp-route-scope="External" asp-route-recordType="Settlement" asp-route-recordId="@row.SettlementId" asp-route-view="@Model.ActiveTab">编辑</a> }@if (row.SourceType != LedgerSourceType.CentralLedger && !string.IsNullOrWhiteSpace(row.SourceUrl)) { <a class="action-button action-button--source" href="@row.SourceUrl">来源</a> }</div></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (currentRows.Count == 0 || (Model.ActiveTab == "exceptions" && !currentRows.Any(item => item.Metrics.AdvanceInvoiceCash > 0m || item.Metrics.OverSettlementCash > 0m || item.Metrics.OverInvoiced > 0m))) { <div class="empty-state"><strong>当前业务区没有结算记录</strong><p>调整筛选条件，或从项目、班组、合作商及中央账本新增业务。</p></div> }
                </section>
            }

            @if (Model.ActiveTab is "collection" or "payment")
            {
                var cashEntries = (Model.Result.CashEntries ?? []).Where(item => Model.ActiveTab == "collection" ? item.Direction == LedgerDirection.Receivable : item.Direction == LedgerDirection.Payable).ToArray();
                <section class="panel ledger-tab-panel"><div class="panel-heading"><div><p class="eyebrow">资金记录</p><h2>@(Model.ActiveTab == "collection" ? "收款" : "付款")</h2><p>资金单头与中央账本分摊保持一对多关系，来源记录只读。</p></div><span class="result-count">共 @cashEntries.Length 笔</span></div>
                    <div class="table-wrap ledger-table-wrap"><table class="data-table ledger-workspace-table ledger-header-table"><thead><tr><th>日期</th><th>资金账户</th><th>合作单位</th><th>项目</th><th>金额</th><th>已分摊</th><th>待分摊</th><th>方式</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var cash in cashEntries) { var canEdit = Model.CanManage && cash.SourceType == LedgerSourceType.CentralLedger && cash.AllocatedAmount == 0m; <tr><td><strong>@ProjectDisplayText.DateLabel(cash.BusinessDate)</strong><span class="table-secondary">@(cash.IsReversal ? "冲销" : cash.CashType == LedgerCashType.Collection ? "收款" : "付款")</span></td><td>@(cash.AccountName ?? "未指定账户")</td><td>@(cash.BusinessPartnerName ?? "未指定合作单位")</td><td>@(cash.ProjectName ?? "未指定项目")</td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--paid">@cash.Amount.ToString("N2")</strong></td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--allocated">@cash.AllocatedAmount.ToString("N2")</strong></td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--pending @(cash.UnallocatedAmount > 0m ? "is-pending" : null)">@cash.UnallocatedAmount.ToString("N2")</strong></td><td>@(cash.PaymentMethod ?? "-")</td><td><span class="ledger-source-pill @(cash.SourceType == LedgerSourceType.CentralLedger ? "is-direct" : "is-source")">@(cash.SourceType == LedgerSourceType.CentralLedger ? "中央录入" : "来源记录")</span></td><td><div class="table-action-buttons table-action-buttons--compact ledger-row-actions"><button class="action-button action-button--view" type="button" data-ledger-details-open data-ledger-record-type="Cash" data-ledger-record-id="@cash.Id" data-ledger-record-stamp="@cash.ConcurrencyStamp" data-ledger-details-url="@detailsUrl">查看</button>@if (canEdit) { <a class="action-button action-button--edit" asp-page="/Ledger/Entries/Edit" asp-route-scope="External" asp-route-recordType="Cash" asp-route-recordId="@cash.Id" asp-route-view="@Model.ActiveTab">编辑</a> }</div></td></tr> }</tbody></table></div>
                    @if (cashEntries.Length == 0) { <div class="empty-state"><strong>暂无@(Model.ActiveTab == "collection" ? "收款" : "付款")记录</strong><p>可以在中央账本新增资金记录，或等待来源模块同步。</p></div> }
                </section>
            }

            @if (Model.ActiveTab is "sales-invoice" or "purchase-invoice")
            {
                var invoices = (Model.Result.Invoices ?? []).Where(item => Model.ActiveTab == "sales-invoice" ? item.Direction == LedgerDirection.Receivable : item.Direction == LedgerDirection.Payable).ToArray();
                <section class="panel ledger-tab-panel"><div class="panel-heading"><div><p class="eyebrow">发票记录</p><h2>@(Model.ActiveTab == "sales-invoice" ? "销项发票" : "进项发票")</h2><p>显示发票总额、已分摊和待分摊金额。</p></div><span class="result-count">共 @invoices.Length 张</span></div>
                    <div class="table-wrap ledger-table-wrap"><table class="data-table ledger-workspace-table ledger-header-table"><thead><tr><th>发票日期</th><th>发票号码</th><th>合作单位</th><th>项目</th><th>含税金额</th><th>已分摊</th><th>待分摊</th><th>发票类型</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var invoice in invoices) { var canEdit = Model.CanManage && invoice.SourceType == LedgerSourceType.CentralLedger && invoice.AllocatedAmount == 0m; <tr><td>@ProjectDisplayText.DateLabel(invoice.InvoiceDate)</td><td><strong>@invoice.InvoiceNumber</strong><span class="table-secondary">@(invoice.TaxRate.HasValue ? $"税率 {invoice.TaxRate:P2}" : "税率未填写")</span></td><td>@(invoice.BusinessPartnerName ?? "未指定合作单位")</td><td>@(invoice.ProjectName ?? "未指定项目")</td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--invoice">@invoice.Amount.ToString("N2")</strong></td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--allocated">@invoice.AllocatedAmount.ToString("N2")</strong></td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--pending @(invoice.UnallocatedAmount > 0m ? "is-pending" : null)">@invoice.UnallocatedAmount.ToString("N2")</strong></td><td>@(invoice.InvoiceType ?? "-")</td><td><span class="ledger-source-pill @(invoice.SourceType == LedgerSourceType.CentralLedger ? "is-direct" : "is-source")">@(invoice.SourceType == LedgerSourceType.CentralLedger ? "中央录入" : "来源记录")</span></td><td><div class="table-action-buttons table-action-buttons--compact ledger-row-actions"><button class="action-button action-button--view" type="button" data-ledger-details-open data-ledger-record-type="Invoice" data-ledger-record-id="@invoice.Id" data-ledger-record-stamp="@invoice.ConcurrencyStamp" data-ledger-details-url="@detailsUrl">查看</button>@if (canEdit) { <a class="action-button action-button--edit" asp-page="/Ledger/Entries/Edit" asp-route-scope="External" asp-route-recordType="Invoice" asp-route-recordId="@invoice.Id" asp-route-view="@Model.ActiveTab">编辑</a> }</div></td></tr> }</tbody></table></div>
                    @if (invoices.Length == 0) { <div class="empty-state"><strong>暂无@(Model.ActiveTab == "sales-invoice" ? "销项" : "进项")发票</strong><p>可以在统一录入弹窗登记发票，并选择是否立即分摊。</p></div> }
                </section>
            }

            @if (Model.ActiveTab == "deduction")
            {
                var deductions = Model.Result.Deductions ?? [];
                <section class="panel ledger-tab-panel"><div class="panel-heading"><div><p class="eyebrow">结算后调整</p><h2>扣款记录</h2><p>扣款只改变关联结算的有效金额，不复制现金流水。</p></div><span class="result-count">共 @deductions.Count 笔</span></div>
                    <div class="table-wrap ledger-table-wrap"><table class="data-table ledger-workspace-table ledger-header-table"><thead><tr><th>日期</th><th>关联结算</th><th>合作单位</th><th>项目</th><th>扣款金额</th><th>减少应开票</th><th>原因</th><th>来源</th><th>操作</th></tr></thead><tbody>@foreach (var deduction in deductions) { <tr><td>@ProjectDisplayText.DateLabel(deduction.BusinessDate)</td><td class="table-secondary">@deduction.SettlementId</td><td>@(deduction.BusinessPartnerName ?? "未指定合作单位")</td><td>@(deduction.ProjectName ?? "未指定项目")</td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--deduction">@deduction.Amount.ToString("N2")</strong></td><td>@(deduction.ReduceInvoiceAmount ? "是" : "否")</td><td class="ledger-wrap-cell">@deduction.Reason</td><td><span class="ledger-source-pill @(deduction.SourceType == LedgerSourceType.CentralLedger ? "is-direct" : "is-source")">@(deduction.SourceType == LedgerSourceType.CentralLedger ? "中央录入" : "来源记录")</span></td><td><div class="table-action-buttons table-action-buttons--compact ledger-row-actions"><button class="action-button action-button--view" type="button" data-ledger-details-open data-ledger-record-type="Deduction" data-ledger-record-id="@deduction.Id" data-ledger-record-stamp="@deduction.ConcurrencyStamp" data-ledger-details-url="@detailsUrl">查看</button></div></td></tr> }</tbody></table></div>
                    @if (deductions.Count == 0) { <div class="empty-state"><strong>暂无扣款记录</strong><p>扣款必须关联已有结算，并填写原因。</p></div> }
                </section>
            }

            @if (Model.ActiveTab == "pending")
            {
                var pendingCash = (Model.Result.UnallocatedCash ?? []).Where(item => item.UnallocatedAmount > 0m).ToArray();
                var pendingInvoices = (Model.Result.Invoices ?? []).Where(item => item.UnallocatedAmount > 0m).ToArray();
                <section class="ledger-pending-grid">
                    <section class="panel ledger-tab-panel"><div class="panel-heading"><div><p class="eyebrow">资金分摊</p><h2>待分摊收付款</h2></div><span class="result-count">@pendingCash.Length 笔</span></div><div class="table-wrap ledger-table-wrap"><table class="data-table ledger-header-table"><thead><tr><th>日期</th><th>账户</th><th>合作单位</th><th>待分摊</th><th>操作</th></tr></thead><tbody>@foreach (var cash in pendingCash) { <tr><td>@ProjectDisplayText.DateLabel(cash.BusinessDate)</td><td>@(cash.AccountName ?? "未指定账户")</td><td>@(cash.BusinessPartnerName ?? "未指定合作单位")</td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--pending is-pending">@cash.UnallocatedAmount.ToString("N2")</strong></td><td><button class="action-button action-button--view" type="button" data-ledger-details-open data-ledger-record-type="Cash" data-ledger-record-id="@cash.CashEntryId" data-ledger-record-stamp="@cash.ConcurrencyStamp" data-ledger-details-url="@detailsUrl">查看并分摊</button></td></tr> }</tbody></table></div>@if (pendingCash.Length == 0) { <div class="empty-state"><strong>没有待分摊资金</strong></div> }</section>
                    <section class="panel ledger-tab-panel"><div class="panel-heading"><div><p class="eyebrow">发票分摊</p><h2>待分摊发票</h2></div><span class="result-count">@pendingInvoices.Length 张</span></div><div class="table-wrap ledger-table-wrap"><table class="data-table ledger-header-table"><thead><tr><th>发票日期</th><th>发票号码</th><th>合作单位</th><th>待分摊</th><th>操作</th></tr></thead><tbody>@foreach (var invoice in pendingInvoices) { <tr><td>@ProjectDisplayText.DateLabel(invoice.InvoiceDate)</td><td><strong>@invoice.InvoiceNumber</strong></td><td>@(invoice.BusinessPartnerName ?? "未指定合作单位")</td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--pending is-pending">@invoice.UnallocatedAmount.ToString("N2")</strong></td><td><button class="action-button action-button--view" type="button" data-ledger-details-open data-ledger-record-type="Invoice" data-ledger-record-id="@invoice.Id" data-ledger-record-stamp="@invoice.ConcurrencyStamp" data-ledger-details-url="@detailsUrl">查看并分摊</button></td></tr> }</tbody></table></div>@if (pendingInvoices.Length == 0) { <div class="empty-state"><strong>没有待分摊发票</strong></div> }</section>
                </section>
            }

            @if (Model.ActiveTab == "payroll")
            {
                <section class="panel ledger-tab-panel" id="payroll-payments"><div class="panel-heading"><div><p class="eyebrow">工资台账自动并入</p><h2>工资付款</h2><p>工资批次形成一笔真实账户流出，人员分配不在中央账本重复记账。</p></div><strong class="ledger-highlight-total">@Model.Result.PayrollPaymentTotal.ToString("N2")</strong></div><div class="table-wrap ledger-table-wrap"><table class="data-table ledger-workspace-table ledger-header-table"><thead><tr><th>发放日期</th><th>工资批次</th><th>自有公司</th><th>项目</th><th>付款账户</th><th>员工</th><th>班组</th><th>实际总额</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var payment in Model.Result.PayrollPayments ?? []) { var statusLabel = payment.Status switch { PayrollBatchStatus.Confirmed => "已核对", PayrollBatchStatus.Closed => "已关闭", PayrollBatchStatus.ModifiedPendingReview => "修改待复核", _ => "未知状态" }; <tr><td>@ProjectDisplayText.DateLabel(payment.PaymentDate)</td><td><strong>@payment.BatchName</strong><span class="table-secondary">@payment.BatchNumber</span></td><td>@payment.LegalEntityName</td><td>@(payment.ProjectName ?? "未指定项目")</td><td>@payment.AccountName</td><td class="numeric-cell">@payment.EmployeeAmount.ToString("N2")</td><td class="numeric-cell">@payment.CrewAmount.ToString("N2")</td><td class="numeric-cell"><strong class="ledger-amount ledger-amount--paid">@payment.ActualAmount.ToString("N2")</strong></td><td><span class="payroll-status payroll-status--@(payment.Status == PayrollBatchStatus.ModifiedPendingReview ? "warning" : "active")">@statusLabel</span></td><td><a class="action-button action-button--source" asp-page="/Payroll/Index" asp-route-id="@payment.BatchId" asp-route-dialog="details">工资详情</a></td></tr> }</tbody></table></div>@if ((Model.Result.PayrollPayments ?? []).Count == 0) { <div class="empty-state"><strong>当前筛选范围没有工资付款</strong></div> }</section>
            }

            @if (Model.ActiveTab is "years" or "reconciliation" or "audit")
            {
                <section class="ledger-summary-panel panel"><div class="panel-heading"><div><p class="eyebrow">中央账本工作区</p><h2>@Model.Tabs.First(item => item.Key == Model.ActiveTab).Label</h2><p>该业务区保持独立页面作为事实来源，中央账本提供当前范围摘要与快捷入口。</p></div></div>
                    @if (Model.ActiveTab == "years") { <div class="ledger-utility-card"><strong>财务业务年度</strong><span>财务年度独立于员工年度，仅控制中央账本统计与对账范围。</span><a class="button button--secondary" asp-page="/Admin/FinanceYears/Index">打开财务年度设置</a></div> }
                    @if (Model.ActiveTab == "reconciliation") { <div class="ledger-utility-card"><strong>对账快照</strong><span>对账不锁定历史；修改后在对账详情中显示快照值、当前值和差异。</span><a class="button button--secondary" asp-page="/Ledger/Reconciliations/Index" asp-route-scope="External">打开外部账对账</a></div> }
                    @if (Model.ActiveTab == "audit") { var audits = Model.Result.AuditEntries ?? []; if (audits.Count == 0) { <div class="empty-state"><strong>当前筛选范围没有修改记录</strong></div> } else { <div class="ledger-audit-list">@foreach (var audit in audits) { <article><div><strong>@audit.Action</strong><span>@audit.EntityType · @audit.RecordId</span></div><div><span>@(audit.UserName ?? "系统") · @audit.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span><small>@(audit.Reason ?? "未填写原因")</small></div></article> }</div> } }
                </section>
            }
        </main>
    </section>
</div>

<dialog class="workbench-dialog ledger-details-dialog" data-ledger-details-dialog>
    <div class="workbench-dialog-heading"><span class="mac-window-controls" aria-hidden="true"><i></i><i></i><i></i></span><div><strong data-ledger-details-title>财务记录详情</strong><span data-ledger-details-subtitle>中央账本记录</span></div><button type="button" class="dialog-close" aria-label="关闭财务记录详情" data-ledger-dialog-close>×</button></div>
    <div class="entity-details-body" data-ledger-details-body><div class="empty-state" data-ledger-details-loading><strong>正在加载详情…</strong></div><div data-ledger-details-content hidden><div class="entity-detail-sections"><section class="entity-detail-section entity-detail-section--wide"><h3 class="entity-detail-section-heading">基本信息</h3><dl class="entity-detail-field-grid" data-ledger-basic-fields></dl></section><section class="entity-detail-section entity-detail-section--wide"><h3 class="entity-detail-section-heading">金额汇总</h3><div class="ledger-details-metrics" data-ledger-metrics></div></section><section class="entity-detail-section entity-detail-section--wide"><h3 class="entity-detail-section-heading">分摊明细</h3><div class="table-wrap ledger-details-allocation-wrap"><table class="data-table"><thead><tr><th>结算 ID</th><th>项目</th><th>合同</th><th>金额</th><th>顺序</th></tr></thead><tbody data-ledger-allocations></tbody></table></div></section><section class="entity-detail-section entity-detail-section--wide"><h3 class="entity-detail-section-heading">来源与操作</h3><div class="ledger-details-source" data-ledger-source></div></section></div></div></div>
    <div class="quick-edit-actions"><span class="equipment-dialog-action-spacer"></span><button type="button" class="button button--secondary" data-ledger-dialog-close>关闭</button><a class="button button--primary" data-ledger-detail-edit hidden>编辑</a><button type="button" class="button button--danger" data-ledger-delete-open hidden>删除</button></div>
</dialog>

<dialog class="workbench-dialog ledger-delete-dialog" data-ledger-delete-dialog>
    <form method="post" asp-page="/Ledger/Entries/Edit" asp-page-handler="Delete">
        @Html.AntiForgeryToken()
        <div class="workbench-dialog-heading"><div><strong>确认删除财务记录</strong><span>删除会解除当前分摊并写入不可变删除日志。</span></div><button type="button" class="dialog-close" aria-label="关闭删除确认" data-ledger-delete-close>×</button></div>
        <div class="quick-edit-body"><div class="ledger-danger-note">仅允许删除中央账本直接录入且未发生核心分摊的记录。来源记录、已分摊记录请返回来源模块或使用调整/冲销。</div><label>删除原因<textarea name="DeleteReason" rows="4" required placeholder="请填写可追溯的删除原因"></textarea></label><input type="hidden" name="DeleteRecordType" data-ledger-delete-type /><input type="hidden" name="DeleteRecordId" data-ledger-delete-id /><input type="hidden" name="DeleteConcurrencyStamp" data-ledger-delete-stamp /></div>
        <div class="workbench-dialog-actions"><button type="button" class="button button--secondary" data-ledger-delete-close>取消</button><button type="submit" class="button button--danger">确认删除</button></div>
    </form>
</dialog>

@section Scripts {
    <script type="module" src="~/js/pages/central-ledger-workspace.js" asp-append-version="true"></script>
}
